#!/bin/bash

set -e

{{ include ".chezmoitemplates/lib.sh" }}

log_step "⚙️  System Settings Configuration"

log_substep "Configuring Fish shell as default..."

if ! command -v /opt/homebrew/bin/fish >/dev/null 2>&1; then
    log_error "Fish shell not found at /opt/homebrew/bin/fish"
    log_info "Skipping shell configuration"
else
    if [ "$SHELL" != "/opt/homebrew/bin/fish" ]; then
        if ! grep -q "/opt/homebrew/bin/fish" /etc/shells; then
            log_info "Adding fish to /etc/shells (requires sudo)..."
            echo /opt/homebrew/bin/fish | sudo tee -a /etc/shells >/dev/null
        fi

        if chsh -s /opt/homebrew/bin/fish; then
            log_success "Fish shell set as default"
        else
            log_warning "Failed to set fish as default shell"
        fi
    else
        log_success "Fish shell is already the default"
    fi
fi

log_substep "Closing System Settings to prevent conflicts..."
osascript -e 'tell application "System Settings" to quit' 2>/dev/null || true

log_substep "🖥️  Configuring Menu Bar..."
defaults write $HOME/Library/Preferences/ByHost/com.apple.controlcenter.plist "Sound" -int 8 || log_warning "Could not hide Sound from menu bar"
defaults write $HOME/Library/Preferences/ByHost/com.apple.controlcenter.plist "Bluetooth" -int 8 || log_warning "Could not hide Bluetooth from menu bar"
defaults write $HOME/Library/Preferences/ByHost/com.apple.controlcenter.plist "WiFi" -int 8 || log_warning "Could not hide WiFi from menu bar"
defaults -currentHost write com.apple.Spotlight MenuItemHidden -int 1 || log_warning "Could not hide Spotlight from menu bar"

defaults write com.apple.menuextra.clock "Show24Hour" -bool "true" || log_warning "Could not set 24-hour clock"
defaults write com.apple.menuextra.clock "ShowDate" -bool "true" || log_warning "Could not enable clock date"
defaults write com.apple.menuextra.clock "ShowDayOfWeek" -bool "true" || log_warning "Could not enable clock day of week"
defaults write com.apple.menuextra.clock "ShowSeconds" -bool "true" || log_warning "Could not enable clock seconds"
log_success "Menu bar configured"

log_substep "🔒 Configuring Security & Privacy..."
defaults write com.apple.screensaver askForPassword -int 1 || log_warning "Could not enable ask-for-password on wake"
defaults write com.apple.screensaver askForPasswordDelay -int 0 || log_warning "Could not set ask-for-password delay"
log_success "Security settings configured"

log_substep "⌨️  Configuring Keyboard & Input..."
defaults write NSGlobalDomain AppleKeyboardUIMode -int 3 || log_warning "Could not enable full keyboard access"

HOTKEYS_PLIST="$HOME/Library/Preferences/com.apple.symbolichotkeys.plist"
for hotkey_id in 64 65; do
    /usr/libexec/PlistBuddy -c "Set :AppleSymbolicHotKeys:${hotkey_id}:enabled false" "$HOTKEYS_PLIST" 2>/dev/null \
        || /usr/libexec/PlistBuddy -c "Add :AppleSymbolicHotKeys:${hotkey_id}:enabled bool false" "$HOTKEYS_PLIST" 2>/dev/null \
        || log_warning "Could not disable Spotlight hotkey ${hotkey_id}"
done

# Resets "Move focus to next window" to Cmd-` regardless of prior manual
# customization, so the Karabiner Hyper+arrow bindings (which emit
# Cmd-`/Cmd-Shift-`) reliably work.
/usr/libexec/PlistBuddy -c "Delete :AppleSymbolicHotKeys:27" "$HOTKEYS_PLIST" 2>/dev/null || true
if /usr/libexec/PlistBuddy -c "Add :AppleSymbolicHotKeys:27:enabled bool true" "$HOTKEYS_PLIST" 2>/dev/null \
    && /usr/libexec/PlistBuddy -c "Add :AppleSymbolicHotKeys:27:value:type string standard" "$HOTKEYS_PLIST" 2>/dev/null \
    && /usr/libexec/PlistBuddy -c "Add :AppleSymbolicHotKeys:27:value:parameters array" "$HOTKEYS_PLIST" 2>/dev/null \
    && /usr/libexec/PlistBuddy -c "Add :AppleSymbolicHotKeys:27:value:parameters:0 integer 96" "$HOTKEYS_PLIST" 2>/dev/null \
    && /usr/libexec/PlistBuddy -c "Add :AppleSymbolicHotKeys:27:value:parameters:1 integer 50" "$HOTKEYS_PLIST" 2>/dev/null \
    && /usr/libexec/PlistBuddy -c "Add :AppleSymbolicHotKeys:27:value:parameters:2 integer 1048576" "$HOTKEYS_PLIST" 2>/dev/null; then
    :
else
    log_warning "Could not reset 'move focus to next window' hotkey"
fi

# PlistBuddy edits the plist file directly, bypassing cfprefsd -- which owns
# this domain's in-memory cache and has no idea the file changed. Without
# killing it here, cfprefsd can flush its still-stale in-memory copy back
# over our on-disk edit at some later, unpredictable point (a subsequent
# 'defaults write' elsewhere, a cache eviction, etc.), silently reverting
# the hotkey back to whatever it was before. Confirmed live: the hotkey
# read back correctly via 'defaults export' right after this script ran,
# but the *actual* shortcut in System Settings had drifted back to
# Cmd-Escape -- restarting cfprefsd is what makes the on-disk write stick.
killall cfprefsd 2>/dev/null || true
log_success "Keyboard settings configured"

log_substep "🔄 Configuring Software Update..."
defaults write com.apple.SoftwareUpdate ScheduleFrequency -int 1 || log_warning "Could not set software update frequency"
log_success "Software update configured"

log_substep "📁 Configuring Finder..."
defaults write com.apple.finder FXPreferredViewStyle -string "clmv" || log_warning "Could not set Finder view style"
defaults write com.apple.finder FXPreferredGroupBy -string "Date Last Opened" || log_warning "Could not set Finder group-by"

defaults write com.apple.finder EmptyTrashSecurely -bool true || log_warning "Could not enable secure empty trash"
log_success "Finder configured"

log_substep "📦 Configuring Dock..."
defaults write com.apple.dock "show-recents" -bool false || log_warning "Could not disable Dock recent applications"
log_success "Dock configured"

log_substep "💾 Configuring System Dialogs..."
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true || log_warning "Could not expand save panel"
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode2 -bool true || log_warning "Could not expand save panel (2)"

defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true || log_warning "Could not expand print panel"
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint2 -bool true || log_warning "Could not expand print panel (2)"

defaults write com.apple.print.PrintingPrefs "Quit When Finished" -bool true || log_warning "Could not enable auto-quit printer app"
log_success "System dialogs configured"

log_substep "🧭 Configuring Safari..."

if [[ -d "$HOME/Library/Containers/com.apple.Safari/Data/Library/Preferences" && -w "$HOME/Library/Containers/com.apple.Safari/Data/Library/Preferences" ]]; then
    killall Safari 2>/dev/null || true

    defaults write com.apple.Safari WebKitTabToLinksPreferenceKey -bool true
    defaults write com.apple.Safari com.apple.Safari.ContentPageGroupIdentifier.WebKit2TabsToLinks -bool true
    defaults write com.apple.Safari IncludeInternalDebugMenu -bool true
    defaults write com.apple.Safari IncludeDevelopMenu -bool true
    defaults write com.apple.Safari WebKitDeveloperExtrasEnabledPreferenceKey -bool true
    defaults write com.apple.Safari com.apple.Safari.ContentPageGroupIdentifier.WebKit2DeveloperExtrasEnabled -bool true
    defaults write com.apple.Safari AutoFillFromAddressBook -bool false
    defaults write com.apple.Safari AutoFillPasswords -bool false
    defaults write com.apple.Safari AutoFillCreditCardData -bool false
    defaults write com.apple.Safari AutoFillMiscellaneousForms -bool false
    defaults write com.apple.Safari SendDoNotTrackHTTPHeader -bool true
    defaults write com.apple.Safari InstallExtensionUpdatesAutomatically -bool true

    log_success "Safari configured"
else
    log_warning "Safari preferences could not be written"
    echo
    log_info "This requires Full Disk Access for your terminal."
    log_info "Without it, Safari settings will be skipped."
    echo
    echo "Options:"
    echo "  [o] Open System Settings → Privacy & Security → Full Disk Access"
    echo "  [s] Skip Safari configuration"
    echo
    read -r -p "Choose (o/s): " choice || choice="s"

    case "$choice" in
        o|O)
            log_info "Opening Full Disk Access settings…"
            open "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles"
            echo
            log_info "Grant access to your terminal, then re-run chezmoi apply."
            ;;
        *)
            log_info "Skipping Safari configuration."
            ;;
    esac
fi

log_substep "🔧 Configuring Dock applications..."

log_substep "🧭 Configuring Default browser..."
if is_virtual_machine; then
    defaultbrowser safari || log_warning "Could not set Safari as default browser"
else
    defaultbrowser velja || log_warning "Could not set Velja as default browser"
fi

if ! command -v dockutil >/dev/null 2>&1; then
    log_warning "dockutil not found, skipping Dock configuration"
else
    dockutil --remove all --no-restart 2>/dev/null || true

    dockutil --add "/Applications/Messages.app" --no-restart 2>/dev/null || true
    dockutil --add "/Applications/Mail.app" --no-restart 2>/dev/null || true
    dockutil --add "/Applications/Calendar.app" --no-restart 2>/dev/null || true
    if ! is_virtual_machine; then
        dockutil --add "/Applications/Things3.app" --label 'Things' --no-restart 2>/dev/null || true
    fi
    dockutil --add "/Applications/Safari.app" --no-restart 2>/dev/null || true

    dockutil --add "$HOME/Downloads" --view fan --display stack --sort dateadded --no-restart 2>/dev/null || true

    log_success "Dock configured"
fi

log_substep "Restarting system services..."
for app in "ControlCenter" "SystemUIServer" "Dock" "Finder"; do
    killall "${app}" > /dev/null 2>&1 || true
done
log_success "System services restarted"

echo
log_success "System settings configuration complete! 🎉"

{
  // No command_policies: nono refuses to start the sandbox without the
  // generated profile's command declarations, so this one can't run
  // standalone -- it only ever reaches nono transitively, via the
  // generated profile's own "extends".
  "extends": "default",
  "meta": {
    "name": "agent-sandbox-base",
    "description": "Agent-agnostic toolchain groups (mise, go); git/gh policy lives in the generated profile"
  },
  "groups": {
    "include": ["mise_manager", "go_runtime", "go_runtime_macos"]
  }
}

{
  // Shared harness for Claude Code under nono: mise toolchains, gated git/gh.
  "extends": "nolabs-ai/claude",
  "meta": {
    "name": "claude-code-base",
    "description": "Shared harness for Claude Code: mise toolchains, gated git/gh"
  },
  // mise_manager is the built-in group for mise's own paths (/etc/mise,
  // ~/.local/bin/mise, ~/.config/mise, ~/.local/share/mise) -- broader and
  // better-maintained than a hand-picked path.
  "groups": {
    "include": ["mise_manager", "go_runtime", "go_runtime_macos"]
  },

  "command_policies": {
    "commands": {
      // No "approve" rules here: nono's only working approval backend
      // (terminal) can't prompt from inside another TUI's raw-mode
      // terminal, so every decision below is a hard allow or deny instead.
      // Local/reversible git ops (including commit -- 1Password's own
      // Touch ID prompt already gates the signing key) are allowed; only
      // push and destructive local ops are denied.
      "git": {
        "from": {
          "session": {
            "sandbox": {
              // Homebrew-installed git needs its own dylibs (pcre2,
              // gettext) and exec-path helpers (git-remote-https) to run
              // at all under nono's tool-sandbox -- matches the scope of
              // the built-in homebrew_macos group, which isn't itself
              // includable here (CommandSandboxConfig has no "groups"
              // field; built-in groups only apply at the session level).
              // @git:config-files dynamically discovers the right global/
              // system config files (including a custom core.excludesfile)
              // by actually running `git config --list`, rather than
              // hardcoding paths that drift if that setting ever changes.
              // @git:hooks-path/common-dir/worktree/toplevel(-parent) make
              // a global core.hooksPath and `git worktree add` work too.
              "fs_read": [".", "/opt/homebrew", "@git:hooks-path", "@git:common-dir", "@git:worktree", "@git:toplevel"],
              "fs_read_file": ["@git:config-files"],
              "fs_write": [".", "@git:common-dir", "@git:worktree", "@git:toplevel", "@git:toplevel-parent"],
              "unix_socket_bind": ["{{ .chezmoi.homeDir }}/.config/1password/agent.sock"]
            },
            "invocation_policy": {
              "default": "allow",
              "deny": [
                { "argv": { "prefix": ["push"] }, "reason": "publishes to a remote -- run this yourself" },
                { "argv": { "prefix": ["clean"] }, "reason": "irreversibly deletes untracked files" },
                { "argv": { "contains": ["--hard"] }, "reason": "irreversibly discards local changes" },
                { "argv": { "contains": ["-D"] }, "reason": "force-deletes a branch" },
                { "argv": { "prefix": ["filter-branch"] }, "reason": "rewrites history" }
              ]
            }
          },
          // gh shells out to git for repo context (e.g. `gh pr view` with no
          // --repo needs to read the current remote) -- without this edge,
          // that exec is denied since git isn't a command gh has permission
          // to chain into.
          "gh": {
            "sandbox": {
              "fs_read": [".", "/opt/homebrew", "@git:hooks-path", "@git:common-dir", "@git:worktree", "@git:toplevel"],
              "fs_read_file": ["@git:config-files"],
              "fs_write": ["."]
            },
            "invocation_policy": {
              "default": "allow"
            }
          }
        }
      },

      // Same shape for gh: reads/queries allowed by default, anything
      // that visibly changes something on GitHub is denied outright --
      // run those yourself when you actually want to publish/act.
      "gh": {
        "can_use": ["git"],
        "from": {
          "session": {
            "sandbox": {
              "fs_read": [".", "$HOME/.config/gh"],
              "network": { "allow_all": true }
            },
            "invocation_policy": {
              "default": "allow",
              "deny": [
                { "argv": { "prefix": ["pr", "create"] }, "reason": "opens a PR" },
                { "argv": { "prefix": ["pr", "merge"] }, "reason": "merges a PR" },
                { "argv": { "prefix": ["pr", "close"] }, "reason": "closes a PR" },
                { "argv": { "prefix": ["pr", "reopen"] }, "reason": "reopens a PR" },
                { "argv": { "prefix": ["pr", "edit"] }, "reason": "edits a PR" },
                { "argv": { "prefix": ["pr", "review"] }, "reason": "posts a review" },
                { "argv": { "prefix": ["issue", "create"] }, "reason": "opens an issue" },
                { "argv": { "prefix": ["issue", "close"] }, "reason": "closes an issue" },
                { "argv": { "prefix": ["issue", "reopen"] }, "reason": "reopens an issue" },
                { "argv": { "prefix": ["issue", "comment"] }, "reason": "posts a comment" },
                { "argv": { "prefix": ["issue", "edit"] }, "reason": "edits an issue" },
                { "argv": { "prefix": ["release", "create"] }, "reason": "publishes a release" },
                { "argv": { "prefix": ["release", "delete"] }, "reason": "deletes a release" },
                { "argv": { "prefix": ["release", "edit"] }, "reason": "edits a release" },
                { "argv": { "prefix": ["repo", "create"] }, "reason": "creates a repo" },
                { "argv": { "prefix": ["repo", "delete"] }, "reason": "deletes a repo" },
                { "argv": { "prefix": ["repo", "edit"] }, "reason": "edits repo settings" },
                { "argv": { "prefix": ["gist", "create"] }, "reason": "creates a gist" },
                { "argv": { "prefix": ["gist", "delete"] }, "reason": "deletes a gist" },
                { "argv": { "prefix": ["gist", "edit"] }, "reason": "edits a gist" },
                { "argv": { "prefix": ["label", "create"] }, "reason": "creates a label" },
                { "argv": { "prefix": ["label", "delete"] }, "reason": "deletes a label" },
                { "argv": { "prefix": ["label", "edit"] }, "reason": "edits a label" },
                { "argv": { "prefix": ["workflow", "run"] }, "reason": "triggers a workflow" },
                { "argv": { "prefix": ["workflow", "enable"] }, "reason": "enables a workflow" },
                { "argv": { "prefix": ["workflow", "disable"] }, "reason": "disables a workflow" },
                { "argv": { "prefix": ["secret"] }, "reason": "manages repo/org secrets" },
                { "argv": { "prefix": ["variable"] }, "reason": "manages repo/org variables" },
                { "argv": { "prefix": ["auth", "login"] }, "reason": "changes the authenticated account" },
                { "argv": { "prefix": ["auth", "logout"] }, "reason": "changes the authenticated account" },
                { "argv": { "prefix": ["api"] }, "reason": "safety depends on -X method flag, not reliably matchable" }
              ]
            }
          }
        }
      }
    }
  }
}

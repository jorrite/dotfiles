{
  // Extends nono's official Claude Code profile (nolabs-ai/claude pack)
  // with read access to mise-managed toolchains, so language servers and
  // compilers Claude Code spawns can actually find them via PATH.
  // See: https://nono.sh/docs/cli/clients/claude.md
  //
  // Schema verified against the actually-installed `nono` binary via
  // `nono profile schema` / `nono profile guide` / `nono profile validate`,
  // not the web docs -- the web docs describe a different (older/newer)
  // shape than what's installed here (e.g. no top-level "credentials"
  // field, no "intercept"/"match"/"action" array).
  "extends": "nolabs-ai/claude",
  "meta": {
    "name": "claude-code",
    "description": "Claude Code with read access to mise toolchains and gated git/gh"
  },
  "filesystem": {
    "read": ["$HOME/.local/share/mise"]
  },

  "command_policies": {
    // Required by the schema the moment any invocation_policy uses
    // "approve" -- there's no implicit default backend.
    "approval_backends": {
      "terminal": { "type": "terminal" }
    },
    "approval_defaults": {
      "backend": "terminal"
    },
    "commands": {
      // git gets base repo read/write, plus a bind grant for 1Password's
      // actual SSH agent socket (see dot_config/1password/symlink_agent.sock.tmpl).
      // Not $SSH_AUTH_SOCK -- on this machine that env var points at macOS's
      // own generic launchd agent, not 1Password's; 1Password is wired up
      // via ~/.ssh/config's IdentityAgent directive instead. Verified live
      // before relying on it, since the generic docs example uses
      // $SSH_AUTH_SOCK and that would have silently connected to the wrong
      // socket here.
      //
      // Read-only subcommands are allowed outright. Everything that can
      // sign or push (and thus touch the socket above) requires interactive
      // approval, independent of 1Password's own 24h-per-process
      // authorization caching: without this, the first commit or push in a
      // session would trigger Touch ID once, then every subsequent one for
      // the next 24h would sign/authenticate silently. Anything not
      // explicitly recognized also falls through to approval, not silent
      // denial or silent allow.
      "git": {
        "from": {
          "session": {
            "sandbox": {
              "fs_read": ["."],
              "fs_write": ["."],
              "unix_socket_bind": ["{{ .chezmoi.homeDir }}/.config/1password/agent.sock"]
            },
            "invocation_policy": {
              "default": "approve",
              "allow": [
                { "argv": { "prefix": ["status"] } },
                { "argv": { "prefix": ["log"] } },
                { "argv": { "prefix": ["diff"] } },
                { "argv": { "prefix": ["add"] } },
                { "argv": { "prefix": ["branch"] } },
                { "argv": { "prefix": ["checkout"] } },
                { "argv": { "prefix": ["restore"] } },
                { "argv": { "prefix": ["show"] } },
                { "argv": { "prefix": ["stash"] } },
                { "argv": { "prefix": ["rev-parse"] } },
                { "argv": { "prefix": ["config", "--get"] } }
              ],
              "approve": [
                { "argv": { "prefix": ["commit"] }, "reason": "signs with 1Password" },
                { "argv": { "prefix": ["push"] }, "reason": "authenticates with 1Password" },
                { "argv": { "prefix": ["fetch"] }, "reason": "authenticates with 1Password" },
                { "argv": { "prefix": ["clone"] }, "reason": "authenticates with 1Password" },
                { "argv": { "prefix": ["pull"] }, "reason": "authenticates with 1Password" }
              ]
            }
          }
        }
      },

      // gh reads/queries pass through freely; anything not explicitly
      // recognized as read-only -- every write, plus 'gh api' entirely
      // (its safety depends on the -X method flag, e.g. a plain-looking
      // 'gh api graphql -f query=...' can be a mutation, too fragile to
      // pattern-match reliably) -- falls through to the default and
      // requires approval. Uses the same personal `gh auth login` session
      // as normal, deliberately not a separate scoped token: the gate is
      // on the action, not the credential.
      "gh": {
        "from": {
          "session": {
            "sandbox": {
              "fs_read": [".", "$HOME/.config/gh"],
              "network": { "allow_domain": ["api.github.com", "github.com", "*.githubusercontent.com"] }
            },
            "invocation_policy": {
              "default": "approve",
              "allow": [
                { "argv": { "prefix": ["pr", "view"] } },
                { "argv": { "prefix": ["pr", "list"] } },
                { "argv": { "prefix": ["pr", "checks"] } },
                { "argv": { "prefix": ["pr", "diff"] } },
                { "argv": { "prefix": ["pr", "status"] } },
                { "argv": { "prefix": ["issue", "view"] } },
                { "argv": { "prefix": ["issue", "list"] } },
                { "argv": { "prefix": ["issue", "status"] } },
                { "argv": { "prefix": ["repo", "view"] } },
                { "argv": { "prefix": ["repo", "list"] } },
                { "argv": { "prefix": ["run", "view"] } },
                { "argv": { "prefix": ["run", "list"] } },
                { "argv": { "prefix": ["run", "watch"] } },
                { "argv": { "prefix": ["workflow", "view"] } },
                { "argv": { "prefix": ["workflow", "list"] } },
                { "argv": { "prefix": ["release", "view"] } },
                { "argv": { "prefix": ["release", "list"] } },
                { "argv": { "prefix": ["gist", "view"] } },
                { "argv": { "prefix": ["gist", "list"] } },
                { "argv": { "prefix": ["label", "list"] } },
                { "argv": { "prefix": ["search"] } },
                { "argv": { "prefix": ["auth", "status"] } }
              ],
              "approve": [
                { "argv": { "prefix": ["api"] }, "reason": "safety depends on -X method flag, not reliably matchable" }
              ]
            }
          }
        }
      }
    }
  }
}

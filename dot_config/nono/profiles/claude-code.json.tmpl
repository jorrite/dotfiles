{
  // Extends nono's official Claude Code profile (nolabs-ai/claude pack)
  // with read access to mise-managed toolchains, so language servers and
  // compilers Claude Code spawns can actually find them via PATH.
  // See: https://nono.sh/docs/cli/clients/claude.md
  "extends": "nolabs-ai/claude",
  "meta": {
    "name": "claude-code",
    "description": "Claude Code with read access to mise toolchains"
  },
  "filesystem": {
    "read": ["$HOME/.local/share/mise"]
  },

  // 1Password's actual SSH agent socket (see dot_config/1password/symlink_agent.sock.tmpl).
  // Not $SSH_AUTH_SOCK -- on this machine that env var points at macOS's own
  // generic launchd agent, not 1Password's; 1Password is wired up via
  // ~/.ssh/config's IdentityAgent directive instead. Verified live before
  // relying on it, since the generic docs example uses $SSH_AUTH_SOCK and
  // that would have silently connected to the wrong socket here.
  "credentials": {
    "ssh-agent": {
      "type": "local-socket",
      "path": "{{ .chezmoi.homeDir }}/.config/1password/agent.sock",
      "mode": "connect",
      "env_var": "SSH_AUTH_SOCK"
    }
  },

  // git gets base repo read/write, but the ssh-agent credential (and thus
  // any ability to sign or authenticate) is only granted for the specific
  // subcommands that actually need it -- status/log/diff/add/etc. never
  // reach this credential at all. Every matched invocation also requires
  // interactive approval, independent of 1Password's own 24h-per-process
  // authorization caching: without this, the first commit or push in a
  // session would trigger Touch ID once, then every subsequent one for
  // the next 24h would sign/authenticate silently.
  "command_policies": {
    "commands": {
      "git": {
        "sandbox": {
          "fs_read": ["."],
          "fs_write": ["."]
        },
        "intercept": [
          {
            "match": { "argv": { "prefix": ["commit"] } },
            "action": { "type": "approve" },
            "sandbox": { "use_credentials": ["ssh-agent"] }
          },
          {
            "match": { "argv": { "prefix": ["push"] } },
            "action": { "type": "approve" },
            "sandbox": { "use_credentials": ["ssh-agent"] }
          },
          {
            "match": { "argv": { "prefix": ["fetch"] } },
            "action": { "type": "approve" },
            "sandbox": { "use_credentials": ["ssh-agent"] }
          },
          {
            "match": { "argv": { "prefix": ["clone"] } },
            "action": { "type": "approve" },
            "sandbox": { "use_credentials": ["ssh-agent"] }
          },
          {
            "match": { "argv": { "prefix": ["pull"] } },
            "action": { "type": "approve" },
            "sandbox": { "use_credentials": ["ssh-agent"] }
          }
        ]
      },

      // gh reads/queries pass through freely; anything not explicitly
      // recognized as read-only -- every write, plus 'gh api' entirely
      // (its safety depends on the -X method flag, e.g. a plain-looking
      // 'gh api graphql -f query=...' can be a mutation, too fragile to
      // pattern-match reliably) -- falls through to the catch-all and
      // requires approval. Uses the same personal `gh auth login` session
      // as normal, deliberately not a separate scoped token: the gate is
      // on the action, not the credential.
      "gh": {
        "sandbox": {
          "fs_read": [".", "$HOME/.config/gh"],
          "network": { "allow_domain": ["api.github.com", "github.com", "*.githubusercontent.com"] },
          "environment": { "allow_vars": ["PATH", "HOME", "USER", "LANG", "LC_*"] }
        },
        "intercept": [
          { "match": { "argv": { "prefix": ["pr", "view"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["pr", "list"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["pr", "checks"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["pr", "diff"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["pr", "status"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["issue", "view"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["issue", "list"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["issue", "status"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["repo", "view"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["repo", "list"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["run", "view"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["run", "list"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["run", "watch"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["workflow", "view"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["workflow", "list"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["release", "view"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["release", "list"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["gist", "view"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["gist", "list"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["label", "list"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["search"] } }, "action": { "type": "passthrough" } },
          { "match": { "argv": { "prefix": ["auth", "status"] } }, "action": { "type": "passthrough" } },
          { "args": [], "action": { "type": "approve" } }
        ]
      }
    }
  }
}

[user]
	name       = "{{ .user.name }}"
	email      = "{{ .user.email }}"
	signingkey = {{ onepasswordRead "op://afcfz2u36qbb4w5iikx4aol2z4/nkxhzy6vcjhjmcfjqze2qqkxra/public key" }}
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[url "git@github.com:"]
	insteadOf = https://github.com/
[core]
    excludesfile = {{ .chezmoi.homeDir }}/.config/git/gitignore_global
[credential "https://github.com"]
	helper =
	helper = !{{ .chezmoi.homeDir }}/.local/share/mise/shims/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ .chezmoi.homeDir }}/.local/share/mise/shims/gh auth git-credential

#!/bin/bash
# Generates a nono profile scoping gh's L7 endpoint policy and git's ssh
# argv policy to the repo(s) discovered in cwd (origin/upstream), or
# read-only-everywhere if no repo is discovered at all. Named deterministically
# from the repo's toplevel path (so any subdirectory of the same repo maps to
# the same profile) and overwritten fresh on every call -- not a per-launch
# temp file, so there's nothing to clean up; it just reflects whatever the
# repo's remotes currently are. Prints the generated profile's NAME (not path
# -- nono's --extends resolves by name against ~/.config/nono/profiles/, same
# as --profile, and doesn't accept a raw file path) to stdout.
set -euo pipefail

parse_owner_repo() {
    # Accepts git@github.com:owner/repo.git, https://github.com/owner/repo.git,
    # or ssh://git@github.com/owner/repo.git; prints owner/repo, or nothing
    # for anything else (e.g. a non-GitHub remote).
    local url="$1"
    case "$url" in
        git@github.com:*|https://github.com/*|ssh://git@github.com/*) ;;
        *) return ;;
    esac
    echo "$url" | sed -E \
        -e 's#^git@github\.com:##' \
        -e 's#^https://github\.com/##' \
        -e 's#^ssh://git@github\.com/##' \
        -e 's#\.git$##' \
        -e 's#/$##'
}

ORIGIN_REPO=""
UPSTREAM_REPO=""
IDENTIFIER="$(pwd)"
# nono has no dynamic @git: token for a linked worktree's own private
# git-dir (confirmed: @git:common-dir only covers the main repo's shared
# .git, not .git/worktrees/<name> -- where commit actually writes HEAD/
# index/objects-in-progress). Resolved explicitly instead; --absolute-git-dir
# returns the main repo's .git for a regular checkout (redundant with
# common-dir, harmless) or the worktree's own private git-dir when linked.
GIT_DIR=""

TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$TOPLEVEL" ]; then
    IDENTIFIER="$TOPLEVEL"
    GIT_DIR="$(git rev-parse --absolute-git-dir 2>/dev/null || true)"
    origin_url="$(git remote get-url origin 2>/dev/null || true)"
    upstream_url="$(git remote get-url upstream 2>/dev/null || true)"
    [ -n "$origin_url" ] && ORIGIN_REPO="$(parse_owner_repo "$origin_url")"
    [ -n "$upstream_url" ] && UPSTREAM_REPO="$(parse_owner_repo "$upstream_url")"
fi

# Deterministic, not a per-launch temp file: any subdirectory of the same
# repo (or the same non-repo directory) maps to the same profile name, which
# this script overwrites fresh on every call.
HASH="$(printf '%s' "$IDENTIFIER" | shasum -a 256 | cut -c1-16)"
PROFILE_NAME="agent-sandbox-session-$HASH"
PROFILE_PATH="$HOME/.config/nono/profiles/$PROFILE_NAME.json"

# --- git's own deny list: the local/destructive-op denials always apply;
# an unscoped "no repo discovered" launch additionally blocks push outright
# at this layer (repo-independent, unlike ssh's argv match which needs a
# specific repo string) since ssh has no way to generically distinguish
# upload-pack from receive-pack without one.
GIT_DENY='[
    {"argv": {"prefix": ["clean"]}, "reason": "irreversibly deletes untracked files"},
    {"argv": {"contains": ["--hard"]}, "reason": "irreversibly discards local changes"},
    {"argv": {"contains": ["-D"]}, "reason": "force-deletes a branch"},
    {"argv": {"prefix": ["filter-branch"]}, "reason": "rewrites history"},
    {"argv": {"prefix": ["remote", "add"]}, "reason": "would let the session push to a repo the ssh argv policy never scoped"},
    {"argv": {"prefix": ["remote", "set-url"]}, "reason": "would let the session push to a repo the ssh argv policy never scoped"},
    {"argv": {"prefix": ["remote", "rename"]}, "reason": "would let the session push to a repo the ssh argv policy never scoped"},
    {"argv": {"prefix": ["remote", "remove"]}, "reason": "would let the session push to a repo the ssh argv policy never scoped"}
]'

SSH_ALLOW='[]'
SSH_DEFAULT='allow'
GH_ALLOW='[{"method": "GET", "path": "/**"}]'

if [ -n "$ORIGIN_REPO" ] || [ -n "$UPSTREAM_REPO" ]; then
    # At least one repo discovered: scope precisely instead of falling back.
    SSH_DEFAULT='deny'
    GH_ALLOW='[]'

    if [ -n "$ORIGIN_REPO" ]; then
        SSH_ALLOW="$(jq -n --arg repo "$ORIGIN_REPO" --arg q "'" '[
            {argv: {contains: ["git-upload-pack " + $q + $repo + ".git" + $q]}, reason: "read from own repo"},
            {argv: {contains: ["git-receive-pack " + $q + $repo + ".git" + $q]}, reason: "write to own repo"}
        ]')"
        GH_ALLOW="$(jq -n --arg repo "$ORIGIN_REPO" '
            ["GET", "POST", "PATCH", "PUT", "DELETE"] as $methods |
            [$methods[] | {method: ., path: "/repos/\($repo)"}] +
            [$methods[] | {method: ., path: "/repos/\($repo)/**"}]
        ')"
    fi

    if [ -n "$UPSTREAM_REPO" ]; then
        SSH_ALLOW="$(echo "$SSH_ALLOW" | jq --arg repo "$UPSTREAM_REPO" --arg q "'" '. + [
            {argv: {contains: ["git-upload-pack " + $q + $repo + ".git" + $q]}, reason: "read from upstream"}
        ]')"
        GH_ALLOW="$(echo "$GH_ALLOW" | jq --arg repo "$UPSTREAM_REPO" '. + [
            {method: "GET", path: "/repos/\($repo)"},
            {method: "GET", path: "/repos/\($repo)/**"},
            {method: "POST", path: "/repos/\($repo)/pulls"}
        ]')"
    fi
else
    # No repo discovered at all: read-only-everywhere. Push is blocked at
    # the git layer above (GIT_DENY), not here, so ssh needs no restriction.
    GIT_DENY="$(echo "$GIT_DENY" | jq '. + [{"argv": {"prefix": ["push"]}, "reason": "no repo discovered to scope a push to"}]')"
fi

# A herdr-projects coordinator's cwd is its project folder (PROJECT.md),
# never a git repo itself. Grant herdr's own control socket -- which can
# type keystrokes into *any* pane the daemon manages, so it's coordinator-
# only, never a plain cs session -- and read access to PROJECT.md's
# [[repos]] paths, needed for herdr-projects' own git preflight checks when
# starting a thread.
IS_COORDINATOR=false
PROJECT_REPOS='[]'
WORKTREES_DIR=""
if [ -f "PROJECT.md" ]; then
    IS_COORDINATOR=true
    PROJECT_REPOS="$(awk '/^\+\+\+$/{c++; next} c==1 && /^path = /' PROJECT.md \
        | sed -E 's/^path = "(.*)"$/\1/' | jq -R . | jq -s .)"
    WORKTREES_DIR="$(awk '/^\[worktrees\]/{f=1; next} /^\[/{f=0} f && /^directory = /{print; exit}' "$HOME/.config/herdr/config.toml" \
        | sed -E 's/^directory = "(.*)"$/\1/')"
    WORKTREES_DIR="${WORKTREES_DIR/#\~/$HOME}"
fi

# Dedicated git/ssh key (signing + read/write transport, see
# agent-sandbox-ssh-setup and agent-sandbox-ssh-askpass): no ssh-agent, no
# ambient daemon -- ssh/ssh-keygen each decrypt it fresh for one operation
# and never hold it beyond that single process's lifetime. Both paths are
# expected to already exist (agent-sandbox-ssh-setup is sourced by the
# launcher before this script runs).
#
# SSH_ASKPASS must be a bare command name, not an absolute path: nono's
# tool-sandbox mediation only intercepts commands reached through its PATH
# shim (confirmed -- the same reason op-ssh-sign could never work here,
# since it only exists at an absolute app-bundle path).

jq -n \
    --argjson git_deny "$GIT_DENY" \
    --arg ssh_default "$SSH_DEFAULT" \
    --argjson ssh_allow "$SSH_ALLOW" \
    --argjson gh_allow "$GH_ALLOW" \
    --argjson is_coordinator "$IS_COORDINATOR" \
    --argjson project_repos "$PROJECT_REPOS" \
    --arg git_dir "$GIT_DIR" \
    --arg ssh_key_path "$AGENT_SANDBOX_SSH_KEY_PATH" \
    --arg tmpdir "$TMPDIR" \
    '($git_dir | if . == "" then [] else [.] end) as $git_dir_grant |
    {
        extends: "agent-sandbox-base",
        meta: { name: "agent-sandbox-session" },
        network: {
            tls_intercept: { ca_lifecycle: "trusted", ca_validity: "24h", leaf_validity: "15m" }
        },
        # Session-wide, per nono own env_credentials mechanism -- there is
        # no command-scoped equivalent for a raw secret value (only
        # local-socket/raw-file/proxy/ambient exist as command-edge
        # credential types, none of which inject a plain string). Harmless
        # on its own: the passphrase alone cannot decrypt anything without
        # the key file too, and the key file is only ever readable by the
        # ssh/ssh-keygen command edges below, never the session directly.
        env_credentials: {
            "op://afcfz2u36qbb4w5iikx4aol2z4/4smxmjpxpfivhuemag3v3ycztu/passphrase": "AGENT_SANDBOX_SSH_KEY_PASSPHRASE"
        },
        filesystem: (
            if $is_coordinator then
                {
                    unix_socket: ["$HOME/.config/herdr/herdr.sock"],
                    read: $project_repos,
                    # herdr own fixed worktree root (default_config:
                    # [worktrees] directory) -- threads are created here,
                    # not inside the repo itself.
                    allow: ["$HOME/.herdr/worktrees"]
                }
            else {} end
        ),
        command_policies: {
            credentials: {
                "github-pat": {
                    type: "proxy",
                    upstream: "https://api.github.com",
                    credential_key: "op://afcfz2u36qbb4w5iikx4aol2z4/omg7kda2wxyblbnzpm2qsa63ua/6m3ew3245raxoyrnctwfm5pnii",
                    env_var: "GH_TOKEN",
                    inject_header: "Authorization",
                    credential_format: "token {}"
                }
            },
            commands: {
                git: {
                    can_use: ["ssh", "ssh-keygen"],
                    from: {
                        session: {
                            sandbox: {
                                # project_repos (coordinator-only, else []): herdr-projects
                                # runs its own git preflight checks with cwd set directly to
                                # a project repo, outside this session own "."
                                # git_dir_grant: nono has no @git: token for a linked
                                # worktree own private git-dir (only @git:common-dir,
                                # the shared object store) -- without it, commit fails
                                # writing HEAD/index there.
                                fs_read: [".", "/opt/homebrew", "@git:hooks-path", "@git:common-dir", "@git:worktree", "@git:toplevel"] + $project_repos + $git_dir_grant,
                                fs_read_file: ["@git:config-files"],
                                # project_repos again: a coordinator fetch writes
                                # .git/FETCH_HEAD in the repo itself, not just ".".
                                # $tmpdir: git stages the signing buffer (the content
                                # ssh-keygen signs) as a temp file here before invoking
                                # gpg.ssh.program with it.
                                fs_write: [".", "@git:common-dir", "@git:worktree", "@git:toplevel", "@git:toplevel-parent", $tmpdir] + $project_repos + $git_dir_grant,
                                # Overrides only within this sandboxed session -- never
                                # touches the user own ~/.config/git/config. ssh -i
                                # forces the dedicated key specifically, ignoring any
                                # other identity (agent or otherwise) that might
                                # otherwise be offered.
                                environment: {
                                    # AGENT_SANDBOX_SSH_KEY_PASSPHRASE: git itself never
                                    # reads this, but env var filtering is hierarchical --
                                    # ssh-keygen (a child of git) can only inherit what
                                    # git itself was first allowed to have, regardless of
                                    # ssh-keygen own allow_vars (confirmed via testing).
                                    allow_vars: ["PATH", "HOME", "LANG", "LC_*", "TERM", "TMPDIR", "AGENT_SANDBOX_SSH_KEY_PASSPHRASE"],
                                    set_vars: {
                                        GIT_CONFIG_COUNT: "3",
                                        GIT_CONFIG_KEY_0: "user.signingkey",
                                        GIT_CONFIG_VALUE_0: "\($ssh_key_path).pub",
                                        GIT_CONFIG_KEY_1: "gpg.format",
                                        GIT_CONFIG_VALUE_1: "ssh",
                                        GIT_CONFIG_KEY_2: "gpg.ssh.program",
                                        GIT_CONFIG_VALUE_2: "ssh-keygen",
                                        # Bare command name, not "ssh -i ..." -- nono tool-
                                        # sandbox mediation matches argv[0] literally against
                                        # declared commands, so a command line with embedded
                                        # flags here fails to match "ssh" at all (confirmed via
                                        # testing: "cannot exec ssh -i ... -o ..."). The
                                        # actual flags are injected via ssh own argv_prepend
                                        # below instead.
                                        GIT_SSH_COMMAND: "ssh"
                                    }
                                }
                            },
                            invocation_policy: { default: "allow", deny: $git_deny }
                        },
                        gh: {
                            sandbox: {
                                fs_read: [".", "/opt/homebrew", "@git:hooks-path", "@git:common-dir", "@git:worktree", "@git:toplevel"] + $git_dir_grant,
                                fs_read_file: ["@git:config-files"],
                                fs_write: ["."] + $git_dir_grant
                            },
                            invocation_policy: { default: "allow" }
                        }
                    }
                },
                ssh: {
                    can_use: ["agent-sandbox-ssh-askpass"],
                    from: {
                        git: {
                            sandbox: {
                                # "." : ssh needs to resolve its own cwd before it can
                                # exec the askpass child (same requirement as ssh-keygen
                                # below; confirmed via testing, not documented anywhere).
                                fs_read: ["."],
                                fs_read_file: [$ssh_key_path, "$HOME/.ssh/known_hosts"],
                                fs_write_file: ["$HOME/.ssh/known_hosts"],
                                network: { allow_all: true },
                                argv_prepend: ["-i", $ssh_key_path, "-o", "IdentitiesOnly=yes", "-o", "ControlMaster=no", "-o", "ControlPath=none"],
                                environment: {
                                    allow_vars: ["PATH", "HOME", "LANG", "LC_*", "TERM", "AGENT_SANDBOX_SSH_KEY_PASSPHRASE"],
                                    set_vars: { SSH_ASKPASS: "agent-sandbox-ssh-askpass", SSH_ASKPASS_REQUIRE: "force" }
                                }
                            },
                            invocation_policy: { default: $ssh_default, allow: $ssh_allow }
                        }
                    }
                },
                "ssh-keygen": {
                    can_use: ["agent-sandbox-ssh-askpass"],
                    from: {
                        git: {
                            sandbox: {
                                fs_read: [".", $tmpdir],
                                fs_write: [$tmpdir],
                                fs_read_file: [$ssh_key_path, "\($ssh_key_path).pub"],
                                environment: {
                                    allow_vars: ["PATH", "HOME", "LANG", "LC_*", "TERM", "TMPDIR", "AGENT_SANDBOX_SSH_KEY_PASSPHRASE"],
                                    set_vars: { SSH_ASKPASS: "agent-sandbox-ssh-askpass", SSH_ASKPASS_REQUIRE: "force" }
                                }
                            },
                            invocation_policy: { default: "allow" }
                        }
                    }
                },
                "agent-sandbox-ssh-askpass": {
                    from: {
                        ssh: {
                            sandbox: { fs_read: ["."], environment: { allow_vars: ["PATH", "HOME", "AGENT_SANDBOX_SSH_KEY_PASSPHRASE"] } },
                            invocation_policy: { default: "allow" }
                        },
                        "ssh-keygen": {
                            sandbox: { fs_read: ["."], environment: { allow_vars: ["PATH", "HOME", "AGENT_SANDBOX_SSH_KEY_PASSPHRASE"] } },
                            invocation_policy: { default: "allow" }
                        }
                    }
                },
                gh: {
                    can_use: ["git"],
                    from: {
                        session: {
                            sandbox: {
                                fs_read: [".", "$HOME/.config/gh"],
                                network: { allow_domain: ["api.github.com"] },
                                credentials: [
                                    { name: "github-pat", endpoint_policy: { default: "deny", allow: $gh_allow } }
                                ],
                                environment: {
                                    allow_vars: ["PATH", "HOME", "LANG", "LC_*", "TERM", "GH_TOKEN",
                                                 "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY",
                                                 "http_proxy", "https_proxy", "no_proxy", "NONO_PROXY_TOKEN"]
                                }
                            },
                            invocation_policy: {
                                default: "allow",
                                deny: [
                                    {argv: {prefix: ["auth", "login"]}, reason: "changes the authenticated account"},
                                    {argv: {prefix: ["auth", "logout"]}, reason: "changes the authenticated account"},
                                    {argv: {prefix: ["auth", "switch"]}, reason: "changes the authenticated account"},
                                    {argv: {prefix: ["auth", "refresh"]}, reason: "changes token scopes"}
                                ]
                            }
                        }
                    }
                }
            }
        }
    }' > "$PROFILE_PATH"

echo "$PROFILE_NAME"

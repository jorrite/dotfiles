#!/bin/bash
# Discovers which repo(s) the current session should be scoped to, for the
# msb-based sandbox: a plain session scopes to cwd's own git remotes
# (origin = full read/write, upstream = read + PR-create only); a
# herdr-projects coordinator (cwd has PROJECT.md, never a git repo itself)
# gets none -- it never pushes or merges itself, only its own spawned
# threads do, each in their own separately-scoped sandbox -- but still
# needs its managed repos' paths mounted, to run `git worktree add`
# locally when starting a thread.
#
# Prints shell variable assignments to stdout, meant to be eval'd by the
# caller (cs-launch), not executed directly.
set -euo pipefail

parse_owner_repo() {
    # Accepts git@github.com:owner/repo.git, https://github.com/owner/repo.git,
    # or ssh://git@github.com/owner/repo.git; prints owner/repo, or nothing
    # for anything else (e.g. a non-GitHub remote).
    local url="$1"
    case "$url" in
        git@github.com:*|https://github.com/*|ssh://git@github.com/*) ;;
        *) return ;;
    esac
    echo "$url" | sed -E \
        -e 's#^git@github\.com:##' \
        -e 's#^https://github\.com/##' \
        -e 's#^ssh://git@github\.com/##' \
        -e 's#\.git$##' \
        -e 's#/$##'
}

ORIGIN_REPO=""
UPSTREAM_REPO=""
TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$TOPLEVEL" ] && [ -e ".git" ]; then
    echo "agent-sandbox-profile: warning: $(pwd) has .git but 'git rev-parse --show-toplevel' failed or returned empty; no repo scoped" >&2
fi
if [ -n "$TOPLEVEL" ]; then
    origin_url="$(git remote get-url origin 2>/dev/null || true)"
    upstream_url="$(git remote get-url upstream 2>/dev/null || true)"
    [ -n "$origin_url" ] && ORIGIN_REPO="$(parse_owner_repo "$origin_url")"
    [ -n "$upstream_url" ] && UPSTREAM_REPO="$(parse_owner_repo "$upstream_url")"
fi

IS_COORDINATOR=false
PROJECT_REPO_PATHS=""
WRITE_REPOS="$ORIGIN_REPO"
PR_ONLY_REPOS="$UPSTREAM_REPO"

if [ -f "PROJECT.md" ]; then
    IS_COORDINATOR=true
    TOPLEVEL=""
    WRITE_REPOS=""
    PR_ONLY_REPOS=""
    paths=()
    while IFS= read -r repo_path; do
        [ -n "$repo_path" ] && paths+=("$repo_path")
    done < <(awk '/^\+\+\+$/{c++; next} c==1 && /^path = /' PROJECT.md | sed -E 's/^path = "(.*)"$/\1/')
    if [ "${#paths[@]}" -gt 0 ]; then
        PROJECT_REPO_PATHS="$(IFS=,; echo "${paths[*]}")"
    fi
fi

echo "IS_COORDINATOR=$IS_COORDINATOR"
echo "TOPLEVEL=$TOPLEVEL"
echo "WRITE_REPOS=$WRITE_REPOS"
echo "PR_ONLY_REPOS=$PR_ONLY_REPOS"
echo "PROJECT_REPO_PATHS=$PROJECT_REPO_PATHS"

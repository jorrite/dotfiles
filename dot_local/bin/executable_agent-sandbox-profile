#!/bin/bash
# Generates a nono profile scoping gh's L7 endpoint policy and git's ssh
# argv policy to the repo(s) discovered in cwd (origin/upstream), or
# read-only-everywhere if no repo is discovered at all. Named deterministically
# from the repo's toplevel path (so any subdirectory of the same repo maps to
# the same profile) and overwritten fresh on every call -- not a per-launch
# temp file, so there's nothing to clean up; it just reflects whatever the
# repo's remotes currently are. Prints the generated profile's NAME (not path
# -- nono's --extends resolves by name against ~/.config/nono/profiles/, same
# as --profile, and doesn't accept a raw file path) to stdout.
set -euo pipefail

parse_owner_repo() {
    # Accepts git@github.com:owner/repo.git, https://github.com/owner/repo.git,
    # or ssh://git@github.com/owner/repo.git; prints owner/repo, or nothing
    # for anything else (e.g. a non-GitHub remote).
    local url="$1"
    case "$url" in
        git@github.com:*|https://github.com/*|ssh://git@github.com/*) ;;
        *) return ;;
    esac
    echo "$url" | sed -E \
        -e 's#^git@github\.com:##' \
        -e 's#^https://github\.com/##' \
        -e 's#^ssh://git@github\.com/##' \
        -e 's#\.git$##' \
        -e 's#/$##'
}

ORIGIN_REPO=""
UPSTREAM_REPO=""
IDENTIFIER="$(pwd)"
# nono has no dynamic @git: token for a linked worktree's own private
# git-dir (confirmed: @git:common-dir only covers the main repo's shared
# .git, not .git/worktrees/<name> -- where commit actually writes HEAD/
# index/objects-in-progress). Resolved explicitly instead; --absolute-git-dir
# returns the main repo's .git for a regular checkout (redundant with
# common-dir, harmless) or the worktree's own private git-dir when linked.
GIT_DIR=""

# Parent directory of the ORIGINATING repo's own checkout (for the
# sibling-directory read grant below) -- deliberately NOT derived from
# $TOPLEVEL. --show-toplevel resolves to the *worktree's* own root when cwd
# is a linked worktree (confirmed empirically from inside one: this very
# thread's worktree toplevel is under ~/.herdr/worktrees/chezmoi/..., not
# ~/.local/share/chezmoi), so a worktree-rooted parent would mean "other
# worktrees of the same repo" -- useless, and not what "siblings" means
# here. --git-common-dir, by contrast, is documented and confirmed
# empirically to always resolve to the MAIN repo's shared .git even from a
# linked worktree (e.g. ~/.local/share/chezmoi/.git), so its grandparent
# (dirname twice) is the main checkout's own sibling directory regardless of
# where this script is actually running from. nono's @git:toplevel-parent
# token was considered instead, but the profile guide documents it as
# resolving "the current checkout root" -- the same worktree-local
# resolution as --show-toplevel, not the common-dir special case -- so it
# was not used here.
MAIN_REPO_PARENT=""

# meta.repo_discovery (threaded into the generated profile below) records
# which of three outcomes happened here, so a failure is diagnosable from
# the profile file itself afterwards instead of being silently
# indistinguishable from the genuine no-repo case. "no_git" (cwd has no
# .git at all -- e.g. a herdr-projects coordinator's own PROJECT.md folder,
# the only case this script originally supported) and
# "git_metadata_present_but_discovery_failed" (cwd clearly has git
# metadata -- a worktree's .git file or a full repo's .git dir -- yet
# `git rev-parse --show-toplevel` still failed or returned empty) both fall
# through to the same unscoped no-repo profile below, but the latter is a
# meaningfully different, unexpected situation worth surfacing: it's what
# happened for a real linked worktree with a valid .git file and a full
# checkout on disk, root cause unconfirmed (see this thread's report). Also
# printed to stderr immediately, since cs-launch only captures this
# script's stdout (the profile name) -- the warning reaches the pane
# directly rather than requiring anyone to know to go look at the profile
# file after the fact.
REPO_DISCOVERY="ok"
TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$TOPLEVEL" ] && [ -e ".git" ]; then
    REPO_DISCOVERY="git_metadata_present_but_discovery_failed"
    echo "agent-sandbox-profile: warning: $(pwd) has .git but 'git rev-parse --show-toplevel' failed or returned empty; generating an unscoped no-repo profile (see meta.repo_discovery in the generated profile)" >&2
elif [ -z "$TOPLEVEL" ]; then
    REPO_DISCOVERY="no_git"
fi
if [ -n "$TOPLEVEL" ]; then
    IDENTIFIER="$TOPLEVEL"
    GIT_DIR="$(git rev-parse --absolute-git-dir 2>/dev/null || true)"
    COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    [ -n "$COMMON_DIR" ] && MAIN_REPO_PARENT="$(dirname "$(dirname "$COMMON_DIR")")"
    origin_url="$(git remote get-url origin 2>/dev/null || true)"
    upstream_url="$(git remote get-url upstream 2>/dev/null || true)"
    [ -n "$origin_url" ] && ORIGIN_REPO="$(parse_owner_repo "$origin_url")"
    [ -n "$upstream_url" ] && UPSTREAM_REPO="$(parse_owner_repo "$upstream_url")"
fi

# Only ever grant sibling-read access when the originating repo lives
# under the user's actual projects directory, ~/Development or
# ~/development (either capitalization) -- either directly, e.g.
# ~/Development/some-project (sibling parent is ~/Development itself), or
# nested arbitrarily deep, e.g. ~/Development/wrk/github/org/some-repo
# (sibling parent is ~/Development/wrk/github/org, that repo's own real
# immediate parent -- never widened to ~/Development itself). The case
# patterns below are a real path-boundary check (literal "/" after the
# root), not a string prefix match, so ~/DevelopmentOther or
# ~/Development-foo do not qualify. A checkout living entirely outside the
# tree is skipped: treated the same as "no repo discovered" below (an empty
# platform_overrides, not a smaller grant), since there is no general way
# to tell a directory that only holds sibling projects from one that also
# holds unrelated app state. This repo itself is the motivating
# counter-example -- checked out at ~/.local/share/chezmoi, its computed
# sibling parent is ~/.local/share, which also holds unrelated app
# state/caches/credentials for every other tool on the machine, not just
# sibling "projects"; granting read there would be far broader than
# intended, so this guard clears MAIN_REPO_PARENT back to "".
case "$MAIN_REPO_PARENT" in
    "$HOME/Development"|"$HOME/development"|"$HOME/Development"/*|"$HOME/development"/*) ;;
    *) MAIN_REPO_PARENT="" ;;
esac

# Plain-credential file conventions to block within the sibling read grant
# below. Not an exhaustive secret-scan -- a scoped set of widely-recognized
# formats: dotenv files, Terraform's tfvars family ("*.tfvars" already
# matches "*.auto.tfvars" too, since nono's "*" wildcard spans embedded
# dots; ".tfvars.json" is a distinct suffix so it needs its own entry),
# default SSH private-key basenames plus common private-key/cert-bundle
# extensions, cloud-provider credential files, and package-manager/VCS
# dotfiles that commonly embed tokens (deliberately excludes e.g. .pub keys
# and general .aws/.kube directory contents other than their credential
# files, which aren't themselves secret).
CREDENTIAL_DENY_SUFFIXES='[
    "**/.env*", "**/*.env",
    "**/*.tfvars", "**/*.tfvars.json",
    "**/id_rsa", "**/id_dsa", "**/id_ecdsa", "**/id_ed25519",
    "**/*.pem", "**/*.key", "**/*.pfx", "**/*.p12",
    "**/.aws/credentials", "**/.aws/config",
    "**/.kube/config", "**/*.kubeconfig",
    "**/.npmrc", "**/.pypirc", "**/.netrc", "**/.git-credentials"
]'

# Deterministic, not a per-launch temp file: any subdirectory of the same
# repo (or the same non-repo directory) maps to the same profile name, which
# this script overwrites fresh on every call.
HASH="$(printf '%s' "$IDENTIFIER" | shasum -a 256 | cut -c1-16)"
PROFILE_NAME="agent-sandbox-session-$HASH"
PROFILE_PATH="$HOME/.config/nono/profiles/$PROFILE_NAME.json"

# nono silently drops a filesystem grant for a path that does not exist yet
# at profile-generation time (confirmed via its own verbose log: "Profile
# path '...' does not exist, skipping") -- on a machine where no thread has
# ever reported progress yet, this directory does not exist, so the grant
# below would otherwise vanish with no error, and herdr-projects report
# fails with a bare, unhelpful "Operation not permitted".
mkdir -p "$HOME/.herdr-projects/.progress"

# --- git's own deny list: the local/destructive-op denials always apply;
# an unscoped "no repo discovered" launch additionally blocks push outright
# at this layer (repo-independent, unlike ssh's argv match which needs a
# specific repo string) since ssh has no way to generically distinguish
# upload-pack from receive-pack without one.
GIT_DENY='[
    {"argv": {"prefix": ["clean"]}, "reason": "irreversibly deletes untracked files"},
    {"argv": {"contains": ["--hard"]}, "reason": "irreversibly discards local changes"},
    {"argv": {"contains": ["-D"]}, "reason": "force-deletes a branch"},
    {"argv": {"prefix": ["filter-branch"]}, "reason": "rewrites history"},
    {"argv": {"prefix": ["remote", "add"]}, "reason": "would let the session push to a repo the ssh argv policy never scoped"},
    {"argv": {"prefix": ["remote", "set-url"]}, "reason": "would let the session push to a repo the ssh argv policy never scoped"},
    {"argv": {"prefix": ["remote", "rename"]}, "reason": "would let the session push to a repo the ssh argv policy never scoped"},
    {"argv": {"prefix": ["remote", "remove"]}, "reason": "would let the session push to a repo the ssh argv policy never scoped"}
]'

SSH_ALLOW='[]'
SSH_DEFAULT='allow'
GH_ALLOW='[{"method": "GET", "path": "/**"}]'

if [ -n "$ORIGIN_REPO" ] || [ -n "$UPSTREAM_REPO" ]; then
    # At least one repo discovered: scope git/ssh (push/pull transport) and
    # gh's mutating REST methods precisely to it instead of falling back.
    # (GH_ALLOW is rebuilt from scratch by the jq -n calls below, so the
    # any-repo GET rule is appended afterwards instead of seeded here --
    # seeding it here would just get discarded.)
    SSH_DEFAULT='deny'
    GH_ALLOW='[]'

    if [ -n "$ORIGIN_REPO" ]; then
        SSH_ALLOW="$(jq -n --arg repo "$ORIGIN_REPO" --arg q "'" '[
            {argv: {contains: ["git-upload-pack " + $q + $repo + ".git" + $q]}, reason: "read from own repo"},
            {argv: {contains: ["git-receive-pack " + $q + $repo + ".git" + $q]}, reason: "write to own repo"}
        ]')"
        GH_ALLOW="$(jq -n --arg repo "$ORIGIN_REPO" '
            ["GET", "POST", "PATCH", "PUT", "DELETE"] as $methods |
            [$methods[] | {method: ., path: "/repos/\($repo)"}] +
            [$methods[] | {method: ., path: "/repos/\($repo)/**"}]
        ')"
    fi

    if [ -n "$UPSTREAM_REPO" ]; then
        SSH_ALLOW="$(echo "$SSH_ALLOW" | jq --arg repo "$UPSTREAM_REPO" --arg q "'" '. + [
            {argv: {contains: ["git-upload-pack " + $q + $repo + ".git" + $q]}, reason: "read from upstream"}
        ]')"
        GH_ALLOW="$(echo "$GH_ALLOW" | jq --arg repo "$UPSTREAM_REPO" '. + [
            {method: "GET", path: "/repos/\($repo)"},
            {method: "GET", path: "/repos/\($repo)/**"},
            {method: "POST", path: "/repos/\($repo)/pulls"}
        ]')"
    fi

    # Unscoped read: clone/fetch of any OTHER repo over ssh is allowed too,
    # not just origin/upstream -- deliberate, see this profile's git history
    # for the tradeoff. No receive-pack equivalent: push stays allowed only
    # for the origin-repo-scoped rule(s) above, denied everywhere else by
    # SSH_DEFAULT="deny" (upload-pack and receive-pack are distinct literal
    # subcommands on the wire, so this can't be smuggled into a push).
    SSH_ALLOW="$(echo "$SSH_ALLOW" | jq '. + [
        {argv: {contains: ["git-upload-pack"]}, reason: "read any repo via ssh"}
    ]')"
else
    # No repo discovered at all: read-only-everywhere. Push is blocked at
    # the git layer above (GIT_DENY), not here, so ssh needs no restriction.
    GIT_DENY="$(echo "$GIT_DENY" | jq '. + [{"argv": {"prefix": ["push"]}, "reason": "no repo discovered to scope a push to"}]')"
fi

# REST reads are left open to any repo on GitHub -- not just the one(s)
# scoped above -- since the unconditional POST /graphql allow below already
# gives gh's own GraphQL-backed read subcommands (e.g. `gh repo view
# other/repo`, `gh issue list -R other/repo`) equivalent any-repo read
# access today; this just makes plain `gh api repos/...` REST reads
# consistent with that, rather than opening a capability that didn't
# already exist. Mutations (POST/PUT/PATCH/DELETE) stay scoped to exactly
# the discovered repo(s) above, never broadened here.
GH_ALLOW="$(echo "$GH_ALLOW" | jq '. + [{"method": "GET", "path": "/repos/**"}]')"

# GraphQL (unconditional, gh uses it even for `gh auth status`): every
# operation shares one POST /graphql path, un-scopable by method+path alone.
# Safe in practice only because `gh api graphql` itself is denied below (it
# stays blocked even though plain REST GET is now allowed -- see
# GH_API_INVOCATION_DENY) -- gh pr create itself is bound to real local git
# state, and GitHub's own fork-relationship check rejects cross-repo PRs
# regardless.
GH_ALLOW="$(echo "$GH_ALLOW" | jq '. + [{"method": "POST", "path": "/graphql"}]')"

# gh api invocation-layer deny list: GET (the default, or an explicit GET
# override) is allowed to fall through to this policy's overall
# default:"allow"; every mutating method is still denied regardless of path,
# since GH_ALLOW above already permits POST/PATCH/PUT/DELETE too for the
# discovered repo's own paths (scoped by path there, not by whether this
# invocation layer trusts the session to mutate it).
#
# gh's method flag has 4 spellings -- "-X POST" / "-XPOST" (pflag shorthand
# attaches a value with no separator) / "--method POST" / "--method=POST" --
# and nono's argv "contains" matcher only matches an exact, whole-token,
# case-sensitive, contiguous sequence (confirmed empirically with `nono
# why`), so each spelling needs its own rule; there is no wildcard or
# negation to express "anything but GET" in one rule. GitHub's API only
# ever matches upper-case method tokens, so a differently-cased mutating
# attempt would 404/405 harmlessly even if it slipped past this list, but
# upper- and lower-case are both covered anyway since gh does not reject or
# normalize the value itself before sending it.
#
# `gh api graphql` stays denied outright (any method, any flags): GraphQL
# has no method+path split for GH_ALLOW to scope by, queries and mutations
# are indistinguishable from argv alone (both are POST), and `-f`/`-F`
# silently flip gh's *own* default method from GET to POST with no `-X`/
# `--method` token to catch -- `gh api graphql -f query='mutation{...}'`
# would otherwise sail through as an unscoped, fully-authenticated GraphQL
# mutation. The same `-f`/`-F` default-method flip applies to plain REST
# paths too (e.g. `gh api repos/{owner}/{repo}/issues -f title=x` is a real
# POST with no `-X` anywhere in argv), but `-f`/`-F`/`--field`/`--raw-field`
# are reused for unrelated, legitimate flags on other gh subcommands
# (pr/issue create --fill, workflow run --field, project item-edit/
# item-list --field, and `-f` alone also means --force/--follow/--filename/
# --env-file elsewhere) that this same gh-wide invocation_policy governs,
# and nono's argv matcher can't express "only when the first word is api"
# together with "contains this flag" in one rule (validated: a rule must
# define exactly one argv matcher). Denying bare `-f`/`-F` would therefore
# break those other subcommands; narrower --input is the one exception
# (confirmed unique to `gh api` across gh's whole command reference) and is
# denied below. The REST-path -f/-F gap is a known residual: see this
# thread's report.
GH_API_INVOCATION_DENY="$(jq -n '
    ["POST", "PUT", "PATCH", "DELETE"] as $methods |
    ($methods + ($methods | map(ascii_downcase))) as $all_cases |
    [
        {argv: {contains: ["graphql"]}, reason: "gh api graphql is an unscoped single endpoint for both reads and mutations with no method+path split to allow-list by; denied outright regardless of method or flags"},
        {argv: {contains: ["--input"]}, reason: "gh api --input supplies an arbitrary raw request body; denied regardless of method"}
    ] + [$all_cases[] |
        {argv: {contains: ["-X", .]}, reason: "gh api must be GET (the default, or an explicit GET override); \(.) is denied regardless of path"},
        {argv: {contains: ["-X" + .]}, reason: "gh api must be GET (the default, or an explicit GET override); \(.) is denied regardless of path"},
        {argv: {contains: ["--method", .]}, reason: "gh api must be GET (the default, or an explicit GET override); \(.) is denied regardless of path"},
        {argv: {contains: ["--method=" + .]}, reason: "gh api must be GET (the default, or an explicit GET override); \(.) is denied regardless of path"}
    ]
')"

# A herdr-projects coordinator's cwd is its project folder (PROJECT.md),
# never a git repo itself. Grant herdr's own control socket -- which can
# type keystrokes into *any* pane the daemon manages, so it's coordinator-
# only, never a plain cs session -- and read access to PROJECT.md's
# [[repos]] paths, needed for herdr-projects' own git preflight checks when
# starting a thread.
IS_COORDINATOR=false
PROJECT_REPOS='[]'
WORKTREES_DIR=""
if [ -f "PROJECT.md" ]; then
    IS_COORDINATOR=true
    PROJECT_REPOS="$(awk '/^\+\+\+$/{c++; next} c==1 && /^path = /' PROJECT.md \
        | sed -E 's/^path = "(.*)"$/\1/' | jq -R . | jq -s .)"
    WORKTREES_DIR="$(awk '/^\[worktrees\]/{f=1; next} /^\[/{f=0} f && /^directory = /{print; exit}' "$HOME/.config/herdr/config.toml" \
        | sed -E 's/^directory = "(.*)"$/\1/')"
    WORKTREES_DIR="${WORKTREES_DIR/#\~/$HOME}"
fi

# Sibling-read roots for a coordinator, parallel to MAIN_REPO_PARENT above but
# derived from every one of PROJECT_REPOS's paths instead of a single
# cwd-discovered one -- a coordinator's cwd is its project folder, never a
# repo, so MAIN_REPO_PARENT is always "" for it. Same dirname + containment
# guard as MAIN_REPO_PARENT, applied per-repo (each repo keeps its own real
# immediate parent, not a shared hardcoded root) and deduplicated, since a
# project can list several repos that resolve to the very same parent.
COORDINATOR_SIBLING_PARENTS='[]'
if [ "$IS_COORDINATOR" = true ]; then
    parents=()
    while IFS= read -r repo_path; do
        parent="$(dirname "$repo_path")"
        case "$parent" in
            "$HOME/Development"|"$HOME/development"|"$HOME/Development"/*|"$HOME/development"/*)
                parents+=("$parent")
                ;;
        esac
    done < <(echo "$PROJECT_REPOS" | jq -r '.[]')
    if [ "${#parents[@]}" -gt 0 ]; then
        COORDINATOR_SIBLING_PARENTS="$(printf '%s\n' "${parents[@]}" | jq -R . | jq -s 'unique')"
    fi
fi

# Dedicated git/ssh key (signing + read/write transport, see
# agent-sandbox-ssh-setup and agent-sandbox-ssh-askpass): no ssh-agent, no
# ambient daemon -- ssh/ssh-keygen each decrypt it fresh for one operation
# and never hold it beyond that single process's lifetime. Both paths are
# expected to already exist (agent-sandbox-ssh-setup is sourced by the
# launcher before this script runs).
#
# SSH_ASKPASS must be a bare command name, not an absolute path: nono's
# tool-sandbox mediation only intercepts commands reached through its PATH
# shim (confirmed -- the same reason op-ssh-sign could never work here,
# since it only exists at an absolute app-bundle path).

jq -n \
    --argjson git_deny "$GIT_DENY" \
    --arg ssh_default "$SSH_DEFAULT" \
    --argjson ssh_allow "$SSH_ALLOW" \
    --argjson gh_allow "$GH_ALLOW" \
    --argjson gh_api_invocation_deny "$GH_API_INVOCATION_DENY" \
    --argjson is_coordinator "$IS_COORDINATOR" \
    --argjson project_repos "$PROJECT_REPOS" \
    --arg git_dir "$GIT_DIR" \
    --arg ssh_key_path "$AGENT_SANDBOX_SSH_KEY_PATH" \
    --arg tmpdir "$TMPDIR" \
    --arg main_repo_parent "$MAIN_REPO_PARENT" \
    --argjson coordinator_sibling_parents "$COORDINATOR_SIBLING_PARENTS" \
    --argjson credential_deny_suffixes "$CREDENTIAL_DENY_SUFFIXES" \
    --arg repo_discovery "$REPO_DISCOVERY" \
    '($git_dir | if . == "" then [] else [.] end) as $git_dir_grant |
    # Single cwd-discovered parent (plain sessions) plus every qualifying
    # parent of a coordinator own PROJECT_REPOS (coordinator sessions) -- the
    # two are mutually exclusive in practice (MAIN_REPO_PARENT is always ""
    # for a coordinator, coordinator_sibling_parents is always [] for a
    # plain session) but merged rather than branched so either, both, or
    # neither can populate the grant without a separate code path.
    (($main_repo_parent | if . == "" then [] else [.] end) + $coordinator_sibling_parents | unique) as $siblings_grant |
    {
        extends: "agent-sandbox-base",
        # repo_discovery: "ok" | "no_git" | "git_metadata_present_but_discovery_failed"
        # -- see the comment above the TOPLEVEL detection above for what each
        # value means and why it is here.
        meta: { name: "agent-sandbox-session", repo_discovery: $repo_discovery },
        # leaf_validity governs the per-host cert nono mints to decrypt gh
        # GraphQL/REST calls to api.github.com for the github-pat credential
        # proxy below (phantom GH_TOKEN swapped for the real PAT in-flight).
        # Confirmed live: nono mints that leaf cert once per session and
        # never re-mints it on reuse, so once wall-clock time crosses the
        # original 15m validity window every subsequent gh API call fails
        # with "x509: certificate has expired" -- identical expiry timestamp
        # on every failing call, well past 15 minutes into an ordinary
        # multi-hour agent session. Raised to comfortably outlive any single
        # session instead of tuning around the underlying nono staleness
        # bug; capped at ca_validity regardless of the value set here.
        network: {
            tls_intercept: { ca_lifecycle: "trusted", ca_validity: "24h", leaf_validity: "12h" }
        },
        # Session-wide, per nono own env_credentials mechanism -- there is
        # no command-scoped equivalent for a raw secret value (only
        # local-socket/raw-file/proxy/ambient exist as command-edge
        # credential types, none of which inject a plain string). Harmless
        # on its own: the passphrase alone cannot decrypt anything without
        # the key file too, and the key file is only ever readable by the
        # ssh/ssh-keygen command edges below, never the session directly.
        env_credentials: {
            "op://afcfz2u36qbb4w5iikx4aol2z4/4smxmjpxpfivhuemag3v3ycztu/passphrase": "AGENT_SANDBOX_SSH_KEY_PASSPHRASE"
        },
        filesystem: {
            # Every cs session gets herdr own socket now, not just
            # coordinators: herdr-projects own progress reporting
            # (herdr-projects report) needs it too -- it calls back over
            # this socket to confirm which pane it is running in, and
            # silently no-ops without it (confirmed: env vars alone are not
            # enough). Worker threads can plausibly spawn their own
            # sub-threads too, not just coordinators.
            unix_socket: ["$HOME/.config/herdr/herdr.sock"],
            # Progress records live globally under <HERDR_PROJECTS_ROOT>/
            # .progress/<pane-id>.json -- not per-project, not under any
            # worktree. Scoped to just this narrow directory rather than
            # the whole ~/.herdr-projects tree, which also holds other
            # projects own MEMORY.md/instructions/thread briefs that a
            # worker has no business reading (per herdr-projects own
            # THREAD.md: "stay in your working directory").
            allow: ["$HOME/.herdr-projects/.progress"],
            # The herdr-projects binary itself lives under a hash-suffixed
            # plugin checkout that changes on every reinstall/update (same
            # reason herdr-projects-status resolves its path dynamically
            # rather than hardcoding it) -- granted broadly since plugin
            # binaries read-only are not sensitive. project_repos
            # (coordinator-only, else []) joins the same array rather than
            # its own "read" key, which would silently overwrite this one
            # on merge instead of adding to it.
            read: ["$HOME/.config/herdr/plugins"] + $project_repos
        } + (
            if $is_coordinator then
                {
                    # herdr own fixed worktree root (default_config:
                    # [worktrees] directory) -- threads are created here,
                    # not inside the repo itself.
                    allow: ["$HOME/.herdr/worktrees"]
                }
            else {} end
        ),
        # Read-only grant for the directories alongside the discovered repo
        # main checkout (e.g. other projects under ~/.local/share next to
        # ~/.local/share/chezmoi) -- deliberately broad, requested so a
        # session can see sibling repos/files on disk, never write-granted.
        # For a coordinator, $siblings_grant can hold one root per distinct
        # ~/Development parent across all of PROJECT_REPOS, not just one, so
        # the deny list below iterates every root instead of assuming a
        # single one. macOS-only: Landlock (Linux) is a strict allow-list
        # with no kernel-level deny primitive, so a filesystem.deny pattern
        # that overlaps a filesystem.read grant is a hard launch error there
        # (confirmed in nono own profile guide) rather than an enforced
        # carve-out -- there is no way to express "read this directory
        # except these credential-shaped files" safely on Linux short of
        # enumerating every non-credential file, which is not feasible for
        # an arbitrary sibling directory. Seatbelt (macOS) enforces deny-
        # within-allow correctly (including for files created after the
        # sandbox starts), so this profile grants the sibling read there and
        # grants nothing at all on Linux -- fail-safe, not an oversight.
        platform_overrides: (
            if ($siblings_grant | length) == 0 then {} else {
                macos: {
                    filesystem: {
                        read: $siblings_grant,
                        deny: [
                            $siblings_grant[] as $root |
                            $credential_deny_suffixes[] |
                            "\($root)/\(.)"
                        ]
                    }
                }
            } end
        ),
        command_policies: {
            credentials: {
                "github-pat": {
                    type: "proxy",
                    upstream: "https://api.github.com",
                    credential_key: "op://afcfz2u36qbb4w5iikx4aol2z4/omg7kda2wxyblbnzpm2qsa63ua/6m3ew3245raxoyrnctwfm5pnii",
                    env_var: "GH_TOKEN",
                    inject_header: "Authorization",
                    credential_format: "token {}"
                }
            },
            commands: {
                git: {
                    can_use: ["ssh", "ssh-keygen"],
                    from: {
                        session: {
                            sandbox: {
                                # project_repos (coordinator-only, else []): herdr-projects
                                # runs its own git preflight checks with cwd set directly to
                                # a project repo, outside this session own "."
                                # git_dir_grant: nono has no @git: token for a linked
                                # worktree own private git-dir (only @git:common-dir,
                                # the shared object store) -- without it, commit fails
                                # writing HEAD/index there.
                                fs_read: [".", "/opt/homebrew", "@git:hooks-path", "@git:common-dir", "@git:worktree", "@git:toplevel"] + $project_repos + $git_dir_grant,
                                fs_read_file: ["@git:config-files"],
                                # project_repos again: a coordinator fetch writes
                                # .git/FETCH_HEAD in the repo itself, not just ".".
                                # $tmpdir: git stages the signing buffer (the content
                                # ssh-keygen signs) as a temp file here before invoking
                                # gpg.ssh.program with it.
                                fs_write: [".", "@git:common-dir", "@git:worktree", "@git:toplevel", "@git:toplevel-parent", $tmpdir] + $project_repos + $git_dir_grant,
                                # Overrides only within this sandboxed session -- never
                                # touches the user own ~/.config/git/config. ssh -i
                                # forces the dedicated key specifically, ignoring any
                                # other identity (agent or otherwise) that might
                                # otherwise be offered.
                                environment: {
                                    # AGENT_SANDBOX_SSH_KEY_PASSPHRASE: git itself never
                                    # reads this, but env var filtering is hierarchical --
                                    # ssh-keygen (a child of git) can only inherit what
                                    # git itself was first allowed to have, regardless of
                                    # ssh-keygen own allow_vars (confirmed via testing).
                                    allow_vars: ["PATH", "HOME", "LANG", "LC_*", "TERM", "TMPDIR", "AGENT_SANDBOX_SSH_KEY_PASSPHRASE"],
                                    set_vars: {
                                        GIT_CONFIG_COUNT: "3",
                                        GIT_CONFIG_KEY_0: "user.signingkey",
                                        GIT_CONFIG_VALUE_0: "\($ssh_key_path).pub",
                                        GIT_CONFIG_KEY_1: "gpg.format",
                                        GIT_CONFIG_VALUE_1: "ssh",
                                        GIT_CONFIG_KEY_2: "gpg.ssh.program",
                                        GIT_CONFIG_VALUE_2: "ssh-keygen",
                                        # Bare command name, not "ssh -i ..." -- nono tool-
                                        # sandbox mediation matches argv[0] literally against
                                        # declared commands, so a command line with embedded
                                        # flags here fails to match "ssh" at all (confirmed via
                                        # testing: "cannot exec ssh -i ... -o ..."). The
                                        # actual flags are injected via ssh own argv_prepend
                                        # below instead.
                                        GIT_SSH_COMMAND: "ssh"
                                    }
                                }
                            },
                            invocation_policy: { default: "allow", deny: $git_deny }
                        },
                        gh: {
                            sandbox: {
                                fs_read: [".", "/opt/homebrew", "@git:hooks-path", "@git:common-dir", "@git:worktree", "@git:toplevel"] + $git_dir_grant,
                                fs_read_file: ["@git:config-files"],
                                fs_write: ["."] + $git_dir_grant
                            },
                            invocation_policy: { default: "allow" }
                        }
                    }
                },
                ssh: {
                    can_use: ["agent-sandbox-ssh-askpass"],
                    from: {
                        git: {
                            sandbox: {
                                # "." : ssh needs to resolve its own cwd before it can
                                # exec the askpass child (same requirement as ssh-keygen
                                # below; confirmed via testing, not documented anywhere).
                                fs_read: ["."],
                                fs_read_file: [$ssh_key_path, "$HOME/.ssh/known_hosts"],
                                fs_write_file: ["$HOME/.ssh/known_hosts"],
                                network: { allow_all: true },
                                argv_prepend: ["-i", $ssh_key_path, "-o", "IdentitiesOnly=yes", "-o", "ControlMaster=no", "-o", "ControlPath=none"],
                                environment: {
                                    allow_vars: ["PATH", "HOME", "LANG", "LC_*", "TERM", "AGENT_SANDBOX_SSH_KEY_PASSPHRASE"],
                                    set_vars: { SSH_ASKPASS: "agent-sandbox-ssh-askpass", SSH_ASKPASS_REQUIRE: "force" }
                                }
                            },
                            invocation_policy: { default: $ssh_default, allow: $ssh_allow }
                        }
                    }
                },
                "ssh-keygen": {
                    can_use: ["agent-sandbox-ssh-askpass"],
                    from: {
                        git: {
                            sandbox: {
                                fs_read: [".", $tmpdir],
                                fs_write: [$tmpdir],
                                fs_read_file: [$ssh_key_path, "\($ssh_key_path).pub"],
                                environment: {
                                    allow_vars: ["PATH", "HOME", "LANG", "LC_*", "TERM", "TMPDIR", "AGENT_SANDBOX_SSH_KEY_PASSPHRASE"],
                                    set_vars: { SSH_ASKPASS: "agent-sandbox-ssh-askpass", SSH_ASKPASS_REQUIRE: "force" }
                                }
                            },
                            invocation_policy: { default: "allow" }
                        }
                    }
                },
                "agent-sandbox-ssh-askpass": {
                    from: {
                        ssh: {
                            sandbox: { fs_read: ["."], environment: { allow_vars: ["PATH", "HOME", "AGENT_SANDBOX_SSH_KEY_PASSPHRASE"] } },
                            invocation_policy: { default: "allow" }
                        },
                        "ssh-keygen": {
                            sandbox: { fs_read: ["."], environment: { allow_vars: ["PATH", "HOME", "AGENT_SANDBOX_SSH_KEY_PASSPHRASE"] } },
                            invocation_policy: { default: "allow" }
                        }
                    }
                },
                gh: {
                    can_use: ["git"],
                    from: {
                        session: {
                            sandbox: {
                                fs_read: [".", "$HOME/.config/gh"],
                                network: { allow_domain: ["api.github.com"] },
                                credentials: [
                                    { name: "github-pat", endpoint_policy: { default: "deny", allow: $gh_allow } }
                                ],
                                environment: {
                                    allow_vars: ["PATH", "HOME", "LANG", "LC_*", "TERM", "GH_TOKEN",
                                                 "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY",
                                                 "http_proxy", "https_proxy", "no_proxy", "NONO_PROXY_TOKEN"]
                                }
                            },
                            invocation_policy: {
                                default: "allow",
                                deny: [
                                    {argv: {prefix: ["auth", "login"]}, reason: "changes the authenticated account"},
                                    {argv: {prefix: ["auth", "logout"]}, reason: "changes the authenticated account"},
                                    {argv: {prefix: ["auth", "switch"]}, reason: "changes the authenticated account"},
                                    {argv: {prefix: ["auth", "refresh"]}, reason: "changes token scopes"}
                                ] + $gh_api_invocation_deny
                            }
                        }
                    }
                }
            }
        }
    }' > "$PROFILE_PATH"

echo "$PROFILE_NAME"

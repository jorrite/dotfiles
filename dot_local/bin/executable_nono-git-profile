#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Scope nono's mediated git to the repositories around the current directory.

Run on the host before the sandbox starts. It prints the path of a validated nono
profile for the sandboxed `git`:

  reads    any github.com repo, public or private (the token decides what exists)
  writes   origin of the repo at --cwd, and only with --push

gh is mediated too, with a placeholder token: reads are open, and so is GraphQL, because the
proxy cannot look inside a request (an accepted risk: with --push gh can write anywhere the
token can via GraphQL). REST writes are limited to origin, plus a pull request on the upstream
(the upstream remote, or else the repo origin was forked from). Without --push gh only gets
read subcommands.

The profile extends a static base (dot_config/nono/profiles/agent-base.json) that
holds the credentials and the git sandbox, so only the write targets are generated here.

Every launch gets a directory under $XDG_STATE_HOME/nono-git-profile/<id>/ that holds the
profile, two hook stubs and everything the session writes: its temp dir (TMPDIR and
CLAUDE_CODE_TMPDIR point there, so Claude's scratchpad and task output live in it too) and,
when signing, the socket of a private ssh-agent. nono's before hook
(dot_config/nono/hooks/git-session-hook) fills it in, and the after hook, or a watcher when
nono is killed, removes the whole directory.

Commits are signed with a dedicated key that the hook loads from 1Password into that agent,
never onto disk. --no-sign skips the agent and the key, not the directory.

  cs-launch --push

cs-launch is nono run --strict-broker-path --profile "$(nono-git-profile --push)" --allow-cwd --
claude. --strict-broker-path makes nono refuse to start when a directory on PATH is writable by
the sandbox, because a planted binary there would later run outside it.

It extends agent-base and the claude pack from nono (`nono pull nolabs-ai/claude`), and inside
a herdr terminal (HC_TERMINAL_ID is set) also the herdr profile, which lets the agent use hc.
--base replaces that list.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import secrets
import shlex
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

GITHUB_HOST = "github.com"
CREDENTIAL = "gh-git"  # defined in agent-base.json
GH_CREDENTIAL = "gh-api"  # defined in agent-base.json
GH_TIMEOUT = 15
# What the gh command sandbox may read: its config (hosts.yml holds no token, that is in the
# keyring), its installed extensions (without this gh treats them as not installed), the
# working directory, and mise, since gh is usually a mise shim.
GH_FS_READ = [
    "$WORKDIR", "$HOME/.config/gh", "$HOME/.local/share/gh/extensions",
    "$HOME/.config/mise", "$HOME/.local/share/mise", "/etc/mise", "/opt/homebrew",
]
GH_ENV_VARS = ["HOME", "PATH", "USER", "LANG", "LC_*", "TERM"]
# Without a write target gh only gets these subcommands. api is in because it is how review
# comments are read; its writes are stopped by the endpoint policy, and GraphQL by argv.
GH_READ_ONLY = [
    ["pr", "view"], ["pr", "list"], ["pr", "status"], ["pr", "checks"], ["pr", "diff"],
    ["issue", "view"], ["issue", "list"], ["issue", "status"],
    ["repo", "view"], ["repo", "list"], ["run", "list"], ["run", "view"],
    ["workflow", "list"], ["workflow", "view"], ["release", "list"], ["release", "view"],
    ["label", "list"], ["gist", "list"], ["gist", "view"],
    ["search"], ["status"], ["api"], ["auth", "status"], ["version"], ["--version"], ["help"], ["--help"],
]
# With a write target gh may do anything except these.
GH_DENY = [
    (["auth", "login"], "changes the authenticated account"),
    (["auth", "logout"], "changes the authenticated account"),
    (["auth", "switch"], "changes the authenticated account"),
    (["auth", "refresh"], "changes token scopes"),
    (["auth", "setup-git"], "rewrites git's credential helper"),
    (["auth", "token"], "prints a token"),
    (["extension"], "installs and runs code"),
    (["alias"], "can define shell aliases"),
    (["repo", "delete"], "deletes a repository"),
]
HERDR_BASE = "herdr"
HOOK_NAME = "git-session-hook"
SSH_KEYGEN = "/usr/bin/ssh-keygen"
# nono never renews the proxy CA or the leaf certs under it, so intercepted requests fail
# once this passes and only a new session helps (nolabs-ai/nono#1681). Leave leaf_validity
# unset: leaves expire with the CA, and a shorter value only brings the failure forward.
CA_VALIDITY = "30d"
MAX_SOCKET_PATH = 100  # sun_path is 104 bytes on macOS
BEFORE_TIMEOUT = 120  # the 1Password read can wait for an approval
AFTER_TIMEOUT = 15
ORPHAN_AFTER = 3600  # a launch dir whose before hook never ran is stale after this many seconds

_URL_FORM = re.compile(
    r"^(?:https?|ssh|git|git\+ssh|ssh\+git)://(?:[^@/]*@)?(?P<host>[^/:]+)(?::\d+)?/(?P<path>.+)$"
)
_SCP_FORM = re.compile(r"^(?:[^@/:]+@)?(?P<host>[^/:]+):(?P<path>[^/].*)$")
_LAUNCH_ID = re.compile(r"^[0-9a-f]{8}$")


@dataclass(frozen=True)
class Launch:
    """Everything one nono session owns. The session hooks remove it again. Without `sign` it
    holds no agent: the directory is still the session's temp dir and is still cleaned up."""

    dir: Path
    sign: bool = True

    @property
    def sock(self) -> Path:
        return self.dir / "a"

    @property
    def tmp(self) -> Path:
        return self.dir / "tmp"

    @property
    def pubkey(self) -> Path:
        return self.dir / "signing.pub"

    @property
    def profile(self) -> Path:
        return self.dir / "profile.json"

    @property
    def before(self) -> Path:
        return self.dir / "before.sh"

    @property
    def after(self) -> Path:
        return self.dir / "after.sh"

    @classmethod
    def new(cls, state: Path, token: str | None = None, sign: bool = True) -> Launch:
        launch = cls(state / (token or secrets.token_hex(4)), sign)
        if len(str(launch.sock)) > MAX_SOCKET_PATH:
            raise SystemExit(f"nono-git-profile: {launch.sock} is too long for a unix socket, shorten XDG_STATE_HOME")
        return launch

    def create(self, hook: Path) -> None:
        self.dir.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        self.dir.mkdir(mode=0o700)
        self.tmp.mkdir(mode=0o700)
        # A hook config takes no arguments, so what the hook is to do is written into the stub.
        extra = "" if self.sign else " nosign"
        for stub, mode, tail in ((self.before, "before", extra), (self.after, "after", "")):
            stub.write_text(f"#!/bin/sh\nexec {shlex.quote(str(hook))} {mode} {shlex.quote(str(self.dir))}{tail}\n")
            stub.chmod(0o700)


def note(message: str) -> None:
    print(f"nono-git-profile: {message}", file=sys.stderr)


def run(cmd: list[str], timeout: float | None = None) -> str | None:
    """Stdout of a successful command, or None if it failed, timed out or is missing."""
    try:
        done = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return done.stdout if done.returncode == 0 else None


def parse_remote(url: str) -> tuple[str, str] | None:
    """(host, "owner/repo") for an https, ssh or scp-style git URL, else None.

    Never echo the URL itself: https remotes can carry a token in the userinfo.
    """
    url = url.strip()
    match = _URL_FORM.match(url) or _SCP_FORM.match(url)
    if not match:
        return None
    path = match["path"].strip("/").removesuffix(".git")
    parts = path.split("/")
    if len(parts) != 2 or not all(parts):
        return None
    return match["host"].lower(), path


def remote_slug(cwd: str, name: str, runner=run) -> tuple[str, str] | None:
    """(host, slug) of a remote, with insteadOf rewrites applied, or None."""
    url = runner(["git", "-C", cwd, "remote", "get-url", name])
    return parse_remote(url) if url else None


def origin_remote(cwd: str, runner=run) -> tuple[str, str] | None:
    return remote_slug(cwd, "origin", runner)


def fork_parent(slug: str, runner=run) -> str | None:
    """The repo a fork was forked from, or None: not a fork, or the lookup failed."""
    out = runner(["gh", "api", f"repos/{slug}"], timeout=GH_TIMEOUT)
    try:
        data = json.loads(out) if out else None
    except ValueError:
        return None
    parent = ((data or {}).get("parent") or {}).get("full_name") if isinstance(data, dict) else None
    return parent or None


def pr_targets(cwd: str, origin_slug: str, runner=run) -> list[str]:
    """Where pull requests may be opened besides origin: the upstream remote, or else the
    repo origin was forked from."""
    upstream = remote_slug(cwd, "upstream", runner)
    if upstream and upstream[0] == GITHUB_HOST:
        found = upstream[1]
    else:
        found = fork_parent(origin_slug, runner)
    return [found] if found and found.lower() != origin_slug.lower() else []


def identity(cwd: str, runner=run) -> dict[str, str]:
    """git author and committer from the host's config: the sandboxed git has no global config."""
    name = (runner(["git", "-C", cwd, "config", "user.name"]) or "").strip()
    email = (runner(["git", "-C", cwd, "config", "user.email"]) or "").strip()
    if not (name and email):
        return {}
    return {
        "GIT_AUTHOR_NAME": name,
        "GIT_AUTHOR_EMAIL": email,
        "GIT_COMMITTER_NAME": name,
        "GIT_COMMITTER_EMAIL": email,
    }


def endpoint_rules(write_slug: str | None) -> list[dict[str, str]]:
    """git's smart-HTTP requests. Every repo may be read (* is one path segment, so this
    covers both /o/r.git/... and /o/r/...), and only write_slug may be pushed to. git sends
    the path as written in the remote URL, so the push rule covers both forms too."""
    rules = [
        {"method": "GET", "path": "/*/*/info/refs"},
        {"method": "POST", "path": "/*/*/git-upload-pack"},
    ]
    if write_slug:
        for repo in (f"/{write_slug}.git", f"/{write_slug}"):
            rules.append({"method": "POST", "path": f"{repo}/git-receive-pack"})
    return rules


def gh_endpoint_rules(write_slug: str | None, targets: list[str]) -> list[dict[str, str]]:
    """What the proxy lets gh send to api.github.com. Reads are open. GraphQL has to be open
    because gh does nearly everything through it, and the proxy cannot look inside a request,
    so it is open for writes too: an accepted risk, not an oversight. REST writes are
    limited to the write target, and a pull request to the upstream."""
    rules = [{"method": "GET", "path": "/**"}, {"method": "POST", "path": "/graphql"}]
    if write_slug:
        for method in ("POST", "PATCH", "PUT", "DELETE"):
            rules.append({"method": method, "path": f"/repos/{write_slug}"})
            rules.append({"method": method, "path": f"/repos/{write_slug}/**"})
    for target in targets:
        rules.append({"method": "POST", "path": f"/repos/{target}/pulls"})
    return rules


def gh_invocation_policy(write: bool) -> dict:
    if write:
        return {
            "default": "allow",
            "deny": [{"argv": {"prefix": args}, "reason": why} for args, why in GH_DENY],
        }
    return {
        "default": "deny",
        "allow": [{"argv": {"prefix": args}, "reason": "read-only"} for args in GH_READ_ONLY],
        "deny": [
            {"argv": {"contains": ["graphql"]}, "reason": "GraphQL mutations cannot be told from queries"},
            {"argv": {"contains": ["/graphql"]}, "reason": "GraphQL mutations cannot be told from queries"},
        ],
    }


def gh_command(write_slug: str | None, targets: list[str]) -> dict:
    return {
        "can_use": ["git"],
        "from": {
            "session": {
                "sandbox": {
                    "fs_read": GH_FS_READ,
                    "credentials": [
                        {
                            "name": GH_CREDENTIAL,
                            "endpoint_policy": {"default": "deny", "allow": gh_endpoint_rules(write_slug, targets)},
                        }
                    ],
                    "environment": {"allow_vars": GH_ENV_VARS},
                },
                "invocation_policy": gh_invocation_policy(bool(write_slug)),
            }
        },
    }


def git_config_env(pairs: list[tuple[str, str]]) -> dict[str, str]:
    """git config entries as GIT_CONFIG_COUNT/KEY_n/VALUE_n, which need no config file."""
    env = {"GIT_CONFIG_COUNT": str(len(pairs))}
    for i, (key, value) in enumerate(pairs):
        env[f"GIT_CONFIG_KEY_{i}"] = key
        env[f"GIT_CONFIG_VALUE_{i}"] = value
    return env


def build_profile(
    write_slug: str | None,
    bases: list[str],
    env: dict[str, str],
    launch: Launch | None = None,
    targets: list[str] | None = None,
) -> dict:
    # nono refuses to start with tls_intercept and no proxy feature, so it travels with the grant.
    body: dict = {
        "extends": bases,
        "network": {"tls_intercept": {"ca_lifecycle": "session", "ca_validity": CA_VALIDITY}},
    }
    sandbox: dict = {
        "credentials": [
            {"name": CREDENTIAL, "endpoint_policy": {"default": "deny", "allow": endpoint_rules(write_slug)}}
        ]
    }
    env = dict(env)
    if launch:
        body["session_hooks"] = {
            "before": {"script": str(launch.before), "timeout_secs": BEFORE_TIMEOUT},
            "after": {"script": str(launch.after), "timeout_secs": AFTER_TIMEOUT},
        }
        # The before hook exports TMPDIR and CLAUDE_CODE_TMPDIR=<dir>/tmp to the session, which
        # needs to write there.
        body["filesystem"] = {"allow": [str(launch.tmp)]}
    if launch and launch.sign:
        # The agent's socket does not exist yet when nono compiles this, so it is granted by
        # name (a local-socket credential would be refused as missing), and git writes its
        # signing temp files to TMPDIR.
        sandbox["unix_socket_bind"] = [str(launch.sock)]
        sandbox["fs_write"] = [str(launch.dir)]
        sandbox["fs_read_file"] = [SSH_KEYGEN]
        env["SSH_AUTH_SOCK"] = str(launch.sock)
        env["TMPDIR"] = str(launch.tmp)
        env.update(
            git_config_env(
                [
                    ("commit.gpgsign", "true"),
                    ("gpg.format", "ssh"),
                    ("gpg.ssh.program", SSH_KEYGEN),
                    ("user.signingkey", str(launch.pubkey)),
                ]
            )
        )
    if env:
        sandbox["environment"] = {"set_vars": env}
    body["command_policies"] = {
        "commands": {"git": {"sandbox": sandbox}, "gh": gh_command(write_slug, targets or [])}
    }
    if launch:
        name = f"git-{launch.dir.name}"
    else:
        name = "git-" + hashlib.sha256(json.dumps(body, sort_keys=True).encode()).hexdigest()[:12]
    meta = {"name": name, "description": "Generated by nono-git-profile; do not edit"}
    return {"meta": meta, **body}


def sweep(state: Path, now: float | None = None) -> None:
    """Remove launch dirs whose session is gone without the after hook having run (nono
    killed and the watcher too, machine rebooted). The before hook records nono's pid as
    `owner` whether or not there is a signing agent, so that is what says a session is live.
    Hooks from before `owner` existed only recorded the agent's pid in `pid`: sessions they
    started can still be running when this version is first used, so that counts too."""
    now = time.time() if now is None else now
    if not state.is_dir():
        return
    for entry in state.iterdir():
        if not (_LAUNCH_ID.match(entry.name) and entry.is_dir()):
            continue
        pid_file = next((f for f in (entry / "owner", entry / "pid") if f.exists()), None)
        if pid_file:
            try:
                os.kill(int(pid_file.read_text().strip()), 0)
                continue  # still running, the session is live
            except PermissionError:
                continue
            except (ValueError, ProcessLookupError, OSError):
                pass
        elif now - entry.stat().st_mtime < ORPHAN_AFTER:
            continue  # just generated, nono has not started it yet
        shutil.rmtree(entry, ignore_errors=True)


def write_json(path: Path, profile: dict) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(profile, indent=2) + "\n")
    os.replace(tmp, path)


def validate(path: Path) -> bool:
    nono = shutil.which("nono")
    if not nono:
        note("nono not found on PATH, skipping validation")
        return True
    done = subprocess.run([nono, "profile", "validate", str(path)], capture_output=True, text=True)
    if done.returncode:
        text = re.sub(r"\x1b\[[0-9;]*m", "", done.stdout + done.stderr)
        note(f"nono rejected the generated profile {path}:\n{text.strip()}")
        return False
    return True


def default_bases() -> list[str]:
    """agent-base and nono's claude pack, plus hc access when running inside a herdr terminal
    (herdr sets HC_TERMINAL_ID there). Outside herdr the agent gets no way to reach herdr-core."""
    bases = ["agent-base", "nolabs-ai/claude"]
    if os.environ.get("HC_TERMINAL_ID"):
        bases.insert(1, HERDR_BASE)
    return bases


def default_hook() -> Path:
    config = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    return config / "nono" / "hooks" / HOOK_NAME


def main(argv: list[str] | None = None, runner=run) -> int:
    parser = argparse.ArgumentParser(description="Emit a nono profile for mediated git and gh: read any repo, write only to origin.")
    parser.add_argument("--cwd", default=".", help="directory inside the repo (default: current)")
    parser.add_argument("--push", action="store_true", help="also allow git push to origin")
    parser.add_argument("--base", action="append", help="profile to extend, repeatable, replaces the default (agent-base, nolabs-ai/claude, and herdr inside herdr)")
    parser.add_argument("--no-sign", action="store_true", help="no signing agent and no 1Password prompt, commits are not signed (the launch directory stays: it is the session's temp dir)")
    parser.add_argument("--hook", type=Path, default=None, help=f"session hook (default: nono's hooks dir/{HOOK_NAME})")
    parser.add_argument("--state-dir", type=Path, help="where to keep launch dirs (default: $XDG_STATE_HOME/nono-git-profile)")
    parser.add_argument("--json", action="store_true", help="print the profile instead of writing it")
    args = parser.parse_args(argv)

    cwd = str(Path(args.cwd).resolve())
    state = args.state_dir or Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "nono-git-profile"

    origin = origin_remote(cwd, runner)
    write_slug = None
    if args.push:
        if origin and origin[0] == GITHUB_HOST:
            write_slug = origin[1]
        elif origin:
            note(f"--push given but origin is on {origin[0]}, only {GITHUB_HOST} is mediated: nothing is writable")
        else:
            note("--push given but there is no origin remote: nothing is writable")
    targets = pr_targets(cwd, write_slug, runner) if write_slug else []
    note(f"reads: any {GITHUB_HOST} repo the token can read")
    note(f"writes: {write_slug}" if write_slug else "writes: none" + ("" if args.push else " (--push allows origin)"))
    if targets:
        note(f"pull requests: {', '.join(targets)} besides origin")

    hook = args.hook or default_hook()
    launch = Launch.new(state, sign=not args.no_sign)
    if not args.json and not hook.is_file():
        note(f"session hook {hook} is missing, run chezmoi apply")
        return 1

    bases = args.base or default_bases()
    if HERDR_BASE in bases:
        note("inside herdr: the agent can use hc")
    profile = build_profile(write_slug, bases, identity(cwd, runner), launch, targets)
    if args.json:
        print(json.dumps(profile, indent=2))
        return 0

    sweep(state)
    launch.create(hook)
    write_json(launch.profile, profile)
    if not validate(launch.profile):
        shutil.rmtree(launch.dir, ignore_errors=True)
        return 1
    print(launch.profile)
    return 0


if __name__ == "__main__":
    sys.exit(main())

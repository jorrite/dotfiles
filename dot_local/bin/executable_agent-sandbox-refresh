#!/bin/bash
# Pulls the latest jorrite/agent-sandbox image, carries over Claude Code's
# existing authenticated session from the previous snapshot (no
# interactive login needed on every image bump), and re-snapshots. A
# snapshot is tied to one specific image's layers -- there's no "rebase
# this snapshot onto a new base image" operation -- so this has to redo
# the snapshot from scratch each time, just without redoing the OAuth
# login along with it.
set -euo pipefail

IMAGE="ghcr.io/jorrite/agent-sandbox:latest"
SNAPSHOT_GROUP="agent-sandbox"
SNAPSHOT_NAME="ready"

# A bare `cmd &`-then-poll spinner, not a library function: this script
# has no shared lib to pull in (unlike the chezmoi-templated scripts,
# which include .chezmoitemplates/lib.sh), and the operations here are
# all plain foreground commands, not ones worth a real dependency for.
spin() {
    local msg="$1"; shift
    local chars='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    local i=0
    "$@" &
    local pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        printf '\r%s %s' "${chars:i++%${#chars}:1}" "$msg" >&2
        sleep 0.1
    done
    wait "$pid"
    local status=$?
    printf '\r\033[K' >&2
    return $status
}

# GHCR only accepts a classic PAT (confirmed against GitHub's own current
# docs: no fine-grained option).
GHCR_TOKEN="$(op read "op://afcfz2u36qbb4w5iikx4aol2z4/2qjn4qqhkd47suuubzm5zhvslq/6m3ew3245raxoyrnctwfm5pnii")"

# `msb image pull` directly against this image fails outright -- confirmed
# live, reproducibly, "error decoding response body" specifically on this
# image's size/layer structure (a small test image pulls fine, isolating
# it from the auth/config mechanism, which works correctly) -- while
# plain, unrelated to this image specifically, not something fixable from
# here. crane (google/go-containerregistry, daemon-less, no VM needed)
# pulls the exact same image with no issue; `msb image load` already reads
# the resulting tarball correctly, same format `docker save` produces.
PULL_TAR="$(mktemp)"
echo "$GHCR_TOKEN" | crane auth login ghcr.io -u jorrite --password-stdin >/dev/null
spin "Pulling $IMAGE..." crane pull --platform linux/arm64 "$IMAGE" "$PULL_TAR"
spin "Loading image into msb..." msb image load -i "$PULL_TAR" -t "$IMAGE"
rm -f "$PULL_TAR"

NEW_SANDBOX="agent-sandbox-refresh-$$"
spin "Creating sandbox..." msb create --name "$NEW_SANDBOX" "$IMAGE"

if msb snap list 2>/dev/null | grep -q "^${SNAPSHOT_GROUP}:${SNAPSHOT_NAME}\b"; then
    OLD_SANDBOX="agent-sandbox-refresh-old-$$"
    spin "Restoring previous session..." msb snap restore "${SNAPSHOT_GROUP}:${SNAPSHOT_NAME}" --name "$OLD_SANDBOX"
    # .claude.json carried over too, not just the .claude/ directory --
    # login itself works fine from .claude/.credentials.json alone
    # (confirmed live), but .claude.json also holds trust-dialog state
    # and account metadata; skipping it just means Claude Code prints a
    # one-time "config file not found" notice on first launch, recovers
    # on its own either way.
    msb exec -u ubuntu "$OLD_SANDBOX" -- tar -C /home/ubuntu -czf /tmp/claude-state.tar.gz .claude .claude.json
    msb exec -u ubuntu "$OLD_SANDBOX" -- cat /tmp/claude-state.tar.gz \
        | msb exec -u ubuntu "$NEW_SANDBOX" -- tar -C /home/ubuntu -xzf -
    msb rm -f "$OLD_SANDBOX"
    echo "agent-sandbox-refresh: carried over the existing login, not a fresh one" >&2
else
    cat >&2 <<'EOF'

agent-sandbox-refresh: no prior snapshot found.

Claude Code is about to launch inside the new sandbox. Complete the
login flow (it will open a URL to authenticate), then once you're at a
normal Claude Code prompt, type /exit -- that hands control back to this
script, which will snapshot the logged-in state for every future launch.

EOF
    msb exec -u ubuntu -t "$NEW_SANDBOX" -- claude
fi

spin "Snapshotting..." msb snap create "$SNAPSHOT_NAME" --sandbox "$NEW_SANDBOX" --group "$SNAPSHOT_GROUP"
msb rm -f "$NEW_SANDBOX"
echo "agent-sandbox-refresh: done -- ${SNAPSHOT_GROUP}:${SNAPSHOT_NAME} is ready" >&2
